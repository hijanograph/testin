{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "desc": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "blocks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "side": {
            "default": "left",
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "sections": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "paragraphs": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "required": [
          "image"
        ]
      }
    },
    "area": {
      "type": "string"
    },
    "rol": {
      "type": "string"
    },
    "software": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "heroImg": {
      "type": "string"
    },
    "heroAlt": {
      "type": "string"
    },
    "coverImg": {
      "type": "string"
    },
    "coverAlt": {
      "type": "string"
    },
    "wip": {
      "default": false,
      "type": "boolean"
    },
    "musicId": {
      "type": "string"
    },
    "prevSlug": {
      "type": "string"
    },
    "prevLabel": {
      "type": "string"
    },
    "nextSlug": {
      "type": "string"
    },
    "nextLabel": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "tagline",
    "desc",
    "area",
    "rol",
    "software",
    "order"
  ]
}