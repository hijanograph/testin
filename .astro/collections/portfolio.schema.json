{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "desc": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "rol": {
      "type": "string"
    },
    "software": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "heroImg": {
      "type": "string"
    },
    "heroAlt": {
      "type": "string"
    },
    "coverImg": {
      "type": "string"
    },
    "coverAlt": {
      "type": "string"
    },
    "wip": {
      "default": false,
      "type": "boolean"
    },
    "prevSlug": {
      "type": "string"
    },
    "prevLabel": {
      "type": "string"
    },
    "nextSlug": {
      "type": "string"
    },
    "nextLabel": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "tagline",
    "desc",
    "area",
    "rol",
    "software",
    "order"
  ]
}