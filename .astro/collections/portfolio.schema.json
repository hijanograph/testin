{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "desc": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "rol": {
      "type": "string"
    },
    "software": {
      "type": "string"
    },
    "tipo": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "featured": {
      "default": false,
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      ]
    },
    "hidden": {
      "default": false,
      "type": "boolean"
    },
    "wip": {
      "default": false,
      "type": "boolean"
    },
    "heroImg": {
      "type": "string"
    },
    "heroAlt": {
      "type": "string"
    },
    "heroFit": {
      "default": "frame",
      "type": "string",
      "enum": [
        "frame",
        "natural",
        "fluid"
      ]
    },
    "coverImg": {
      "type": "string"
    },
    "coverAlt": {
      "type": "string"
    },
    "wipImg": {
      "type": "string"
    },
    "videoUrl": {
      "type": "string",
      "format": "uri"
    },
    "videoRatio": {
      "default": "16 / 9",
      "type": "string"
    },
    "blocks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string"
          },
          "alt": {
            "default": "",
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "sections": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "paragraphs": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "paragraphs"
              ]
            }
          }
        },
        "required": [
          "image",
          "sections"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "desc",
    "area",
    "rol",
    "order"
  ]
}