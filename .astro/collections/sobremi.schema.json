{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bio": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "photo": {
      "type": "string"
    },
    "photoAlt": {
      "type": "string"
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "companyDesc": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "role",
          "company",
          "period",
          "companyDesc",
          "tasks"
        ]
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "period": {
