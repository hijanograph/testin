      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skillsAreas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cvIntro": {
      "type": "string"
    },
    "cvPdfPath": {
      "type": "string"
    },
    "heroTitle": {
      "type": "string"
    },
    "heroBio": {
      "type": "string"
    },
    "heroImg": {
      "type": "string"
    },
    "heroImgAlt": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  }
