---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { name, withBase } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Diseñador visual que crea espacios donde cada marca cobra vida.',
  image = 'images/index/hero-profile.png',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${name}` : `${name} — Diseñador Visual`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(withBase(image), Astro.site).href : undefined;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fff5e9" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />

    <link
      rel="preload"
      href={withBase('fonts/OverusedGrotesk-Regular.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <ClientRouter />
  </head>

  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>

    <Nav />

    <main id="contenido" tabindex="-1" class="page-transition">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<script>
  const targets = [
    '.section__title', '.section__head', '.split', '.project-card', '.project-block', '.project-wip__media',
    '.project-wip__text', '.project-body', '.banner', '.section__media', '.cv__col', '.cv__img', '.facts > div',
    '.big-email', '.link-list', '.contact-methods', '.project-nav', '.footer__grid',
  ].join(', ');

  const init = () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const belowFold = [...document.querySelectorAll<HTMLElement>(targets)].filter(
      (el) => el.getBoundingClientRect().top > innerHeight,
    );
    if (!belowFold.length) return;

    belowFold.forEach((el) => el.classList.add('reveal'));

    const observer = new IntersectionObserver(
      (entries) => {
        entries
          .filter((entry) => entry.isIntersecting)
          .forEach((entry, i) => {
            const el = entry.target as HTMLElement;
            el.style.setProperty('--reveal-delay', `${Math.min(i, 5) * 70}ms`);
            el.classList.add('is-revealed');
            observer.unobserve(el);
          });
      },
      { rootMargin: '0px 0px -8% 0px' },
    );

    belowFold.forEach((el) => observer.observe(el));
  };

  document.addEventListener('astro:page-load', init);
</script>
