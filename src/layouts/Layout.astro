---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Rafael Hijano — Diseñador Visual',
  description = 'Diseñador visual que crea espacios donde cada marca cobra vida.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Sin Google Fonts: se usa Overused Grotesk local desde public/fonts/ -->
</head>
<body>
  <Nav />
  <main class="page-enter">
    <slot />
  </main>
  <Footer />
</body>
</html>
