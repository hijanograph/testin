---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { name, withBase } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Diseñador visual que crea espacios donde cada marca cobra vida.',
  image = 'images/index/hero-profile.png',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${name}` : `${name} — Diseñador Visual`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(withBase(image), Astro.site).href : undefined;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fff5e9" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />

    <link
      rel="preload"
      href={withBase('fonts/OverusedGrotesk-VF.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <ClientRouter />
  </head>

  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>

    <Nav />

    <main id="contenido" tabindex="-1" class="page-transition">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<script>
  const targets = [
    '.section__title', '.section__head', '.split', '.project-card', '.project-block', '.project-wip__media',
    '.project-wip__text', '.project-body', '.banner', '.section__media', '.cv__col', '.cv__img', '.facts > div',
    '.big-email', '.link-list', '.contact-methods', '.project-nav', '.footer__grid',
  ].join(', ');

  let stop: (() => void) | undefined;

  const init = () => {
    stop?.();
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const items = [...document.querySelectorAll<HTMLElement>(targets)].filter(
      (el) => el.getBoundingClientRect().top > innerHeight,
    );
    if (!items.length) return;

    items.forEach((el) => el.classList.add('reveal'));

    const progress = new WeakMap<HTMLElement, number>();
    let frame = 0;

    const update = () => {
      frame = 0;
      const range = innerHeight * 0.3;
      const rowCount = new Map<number, number>();
      let pending = 0;

      items.forEach((el) => {
        if (!el.classList.contains('reveal') || el.classList.contains('is-revealed')) return;

        const top = el.getBoundingClientRect().top;
        const row = Math.round(top / 8);
        const position = rowCount.get(row) ?? 0;
        rowCount.set(row, position + 1);

        const linear = Math.min(1, Math.max(0, (innerHeight - top - position * 36) / range));
        const eased = 1 - Math.pow(1 - linear, 3);
        const value = Math.max(progress.get(el) ?? 0, eased);
        progress.set(el, value);

        if (value >= 1) {
          el.classList.add('is-revealed');
          el.style.removeProperty('--reveal');
        } else {
          el.style.setProperty('--reveal', value.toFixed(3));
          pending++;
        }
      });

      if (!pending) stop?.();
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    stop = () => {
      removeEventListener('scroll', schedule);
      removeEventListener('resize', schedule);
      cancelAnimationFrame(frame);
      stop = undefined;
    };

    update();
  };

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => stop?.());
</script>
