---
import Layout from '../layouts/Layout.astro';

const skills = [
  'Adobe Illustrator', 'Adobe Photoshop', 'Adobe InDesign',
  'Adobe After Effects', 'Adobe Premiere Pro',
  'Figma', 'WordPress', 'HTML5',
];

const experience = [
  {
    role: 'Diseñador Visual',
    company: 'Batterylight',
    period: 'Feb 2025 — presente',
    companyDesc: 'Batterylight es un proveedor líder de soluciones lumínicas innovadoras, centrado en la eficiencia energética y la sostenibilidad en la industria de la iluminación proyectada.',
    tasks: [
      'Gestión del departamento de marketing, diseño de packaging y edición de catálogos, asegurando la coherencia visual y el cumplimiento de las guías de marca.',
      'Optimización de materiales de venta en formatos editables, garantizando su alineación con los estándares visuales y de marca de la empresa.',
    ],
  },
  {
    role: 'Diseñador de Marca',
    company: 'Freepik',
    period: 'Feb 2024',
    companyDesc: 'Freepik Company S.L. es una plataforma líder de contenido digital que ofrece una amplia gama de recursos gráficos gratuitos y premium, incluyendo fotos, vectores e ilustraciones.',
    tasks: [
      'Participación en el proyecto Neighborhood Design, centrado en la creación de identidad de marca y aplicaciones para un negocio urbano, incluyendo la gestión del rebranding y la coordinación con producción e impresión.',
      'Asistencia en la creación de recursos de marca y materiales de marketing para distintas plataformas, con el objetivo de mejorar la visibilidad y el engagement.',
    ],
  },
  {
    role: 'Marketing Specialist',
    company: 'Ertheo',
    period: 'Feb 2019 — Abr 2020',
    companyDesc: 'Ertheo es una plataforma de cursos deportivos internacionales que conecta jóvenes talentos con academias de élite.',
    tasks: [
      'Gestión de campañas de marketing digital en múltiples mercados europeos.',
      'Creación de materiales de comunicación y coordinación con el equipo de diseño.',
    ],
  },
];

const education = [
  { title: 'Máster en Diseño Visual', institution: 'La X Gauss', period: '2021 — 2023' },
  { title: 'Máster en Dirección y Liderazgo', institution: 'GADE Business School', period: '2020' },
  { title: 'Grado en Comunicación Audiovisual', institution: 'Universidad de Málaga', period: '2015 — 2019' },
];
---

<Layout title="Sobre mí — Rafael Hijano" description="Diseñador Visual en Málaga. Graduado en Comunicación Audiovisual y Máster en Diseño Visual.">
  <div class="page">
    <div class="container">

      <section class="intro">
        <h1 class="t-hero intro__title">Sobre mí</h1>

        <div class="intro__grid">
          <div class="intro__photo-wrap">
            <div class="img-ph intro__photo"></div>
          </div>

          <div class="intro__bio">
            <p class="t-body">
              Soy Rafael, un Diseñador Visual que vive y trabaja en el área de Málaga.
              Me apasiona crear espacios donde las marcas cobran vida y construir proyectos
              con alma, conectando con las personas a través de un diseño cuidado y con propósito.
            </p>
            <p class="t-body">
              Soy graduado de la Universidad de Málaga en Comunicación Audiovisual y cuento con
              un Máster en Diseño Visual de La X Gauss. Mi interés por el diseño nació de forma
              natural: de niño me fascinaban los sistemas interactivos y el arte visual en los
              videojuegos y los ordenadores, lo que me llevó a querer estudiar informática.
              Aunque sabía que mi hábitat se encontraba entre interfaces, algo dentro de mí me
              pedía explorar más mi lado creativo.
            </p>
            <p class="t-body">
              Así fue cómo comencé por segunda vez mi etapa universitaria, y tras explorar la
              comunicación en todas sus formas, descubrí que mi verdadera vocación era contar
              historias a través del diseño visual.
            </p>
            <p class="t-body">
              Actualmente, trabajo como Diseñador Visual en Batterylight. Lidero diferentes
              áreas creativas dentro del departamento de marketing, desde el diseño de packaging
              hasta la edición de catálogos.
            </p>
            <p class="t-body">
              Fuera del diseño, soy un entusiasta de la psicología, la música, la tecnología y
              la cultura geek en general. Cuando tengo tiempo libre, puedes encontrarme leyendo,
              jugando, cocinando, viendo alguna serie o acariciando algún gato.
            </p>
          </div>
        </div>
      </section>

      <hr />

      <div class="cv-cta">
        <a href="/cv-rafael-hijano.pdf" download class="download-btn t-label">
          Descargar CV ↓
        </a>
      </div>

      <section class="section">
        <h2 class="cv-section-label t-label">Experiencia</h2>

        {experience.map((item) => (
          <div class="cv-entry">
            <div class="cv-entry__head">
              <div><strong>{item.role}</strong><span class="cv-company">{item.company}</span></div>
              <span class="t-label">{item.period}</span>
            </div>
            <p class="t-body cv-entry__desc">{item.companyDesc}</p>
            <ul class="cv-tasks">
              {item.tasks.map((t) => <li class="t-body">{t}</li>)}
            </ul>
          </div>
        ))}

        <div class="cv-cta">
          <a href="/cv-rafael-hijano.pdf" download class="download-btn t-label">
            Descargar CV ↓
          </a>
        </div>
      </section>

      <hr />

      <section class="section">
        <h2 class="cv-section-label t-label">Educación</h2>

        {education.map((e) => (
          <div class="cv-entry">
            <div class="cv-entry__head">
              <div><strong>{e.title}</strong><span class="cv-company">{e.institution}</span></div>
              <span class="t-label">{e.period}</span>
            </div>
          </div>
        ))}

        <div class="cv-cta">
          <a href="/cv-rafael-hijano.pdf" download class="download-btn t-label">
            Descargar CV ↓
          </a>
        </div>
      </section>

      <hr />

      <section class="section">
        <h2 class="t-section section__title">Habilidades</h2>
        <div class="skills">
          {skills.map((s) => <span class="skill t-label">{s}</span>)}
        </div>

        <div class="cv-cta">
          <a href="/cv-rafael-hijano.pdf" download class="download-btn t-label">
            Descargar CV ↓
          </a>
        </div>
      </section>

    </div>
  </div>
</Layout>