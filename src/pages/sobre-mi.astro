---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

// CORREGIDO: Apuntamos a 'config' que es como se configuró en el cloudcannon.config.yml
const siteEntry = await getEntry('config', 'site');
const site = siteEntry?.data;

const bio        = site?.bio        ?? [];
const experience = site?.experience ?? [];
const education  = site?.education  ?? [];
const skills     = site?.skills     ?? [];
---

<Layout
  title="Sobre mí — Rafael Hijano"
  description="Diseñador Visual en Málaga. Graduado en Comunicación Audiovisual y Máster en Diseño Visual."
>
  <div class="page">
    <div class="container">

      <!-- ── Intro ── -->
      <section class="intro">
        <h1 class="t-hero intro__title">Sobre mí</h1>

        <div class="intro__grid">
          <!-- Foto -->
          <div class="intro__photo-wrap">
            {site?.photo
              ? <img src={site.photo} alt={site.photoAlt ?? 'Rafael Hijano'} class="intro__photo" />
              : <div class="img-ph img-ph--tall intro__photo"></div>
            }
          </div>

          <!-- Bio -->
          <div class="intro__bio">
            {bio.map((p) => (
              /* CORREGIDO: Accedemos a p.value según la estructura del array de CloudCannon */
              <p class="t-body">{p.value || p}</p>
            ))}
          </div>
        </div>
      </section>

      <hr />

      <!-- ── Experiencia ── -->
      <section class="section">
        <h2 class="t-section section__title">Experiencia</h2>
        <div class="timeline">
          {experience.map((item) => (
            <div class="timeline__item">
              <div class="timeline__head">
                <div>
                  <p class="timeline__role">{item.role}</p>
                  <p class="t-label timeline__company">{item.company}</p>
                </div>
                <span class="t-label timeline__period">{item.period}</span>
              </div>
              <p class="t-body timeline__desc">{item.companyDesc}</p>
              <ul class="timeline__tasks">
                {item.tasks?.map((t) => (
                  /* CORREGIDO: Accedemos a t.value para arrays estructurados */
                  <li class="t-body">{t.value || t}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <hr />

      <!-- ── Educación ── -->
      <section class="section">
        <h2 class="t-section section__title">Educación</h2>
        <div class="edu-grid">
          {education.map((e) => (
            <div class="edu-item">
              <p class="t-label">{e.period}</p>
              <p class="edu-item__title">{e.title}</p>
              <p class="t-label edu-item__inst">{e.institution}</p>
            </div>
          ))}
        </div>
      </section>

      <hr />

      <!-- ── Habilidades ── -->
      <section class="section">
        <h2 class="t-section section__title">Habilidades</h2>
        <div class="skills">
          {skills.map((s) => (
            /* CORREGIDO: Accedemos a s.value según pide el panel */
            <span class="skill t-label">{s.value || s}</span>
          ))}
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
.page {
  padding-top: calc(var(--nav-h) + 3rem);
  padding-bottom: 2rem;
}

/* ── Intro ── */
.intro { margin-bottom: 4rem; }
.intro__title { margin-bottom: 3rem; }
.intro__grid { display: grid; gap: 2rem; }
@media (min-width: 860px) {
  .intro__grid { grid-template-columns: 340px 1fr; gap: 4rem; align-items: start; }
}
.intro__photo { width: 100%; }
.intro__bio { display: flex; flex-direction: column; gap: 1.25rem; }

/* ── Sections ── */
.section { padding: 3.5rem 0; }
.section__title { margin-bottom: 2.5rem; }
hr { margin: 0; }

/* ── Timeline ── */
.timeline { display: flex; flex-direction: column; gap: 3rem; }
.timeline__head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1rem;
}
.timeline__role { font-size: 1.05rem; font-weight: 600; letter-spacing: -0.01em; }
.timeline__company { margin-top: 0.2rem; }
.timeline__period { white-space: nowrap; }
.timeline__desc { margin-bottom: 1rem; max-width: 70ch; }
.timeline__tasks { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
.timeline__tasks li { padding-left: 1.25rem; position: relative; max-width: 70ch; }
.timeline__tasks li::before { content: '—'; position: absolute; left: 0; color: var(--ink-30); }

/* ── Education ── */
.edu-grid { display: grid; gap: 2rem; }
@media (min-width: 640px) { .edu-grid { grid-template-columns: repeat(3, 1fr); } }
.edu-item { display: flex; flex-direction: column; gap: 0.4rem; }
.edu-item__title { font-size: 0.95rem; font-weight: 600; }
.edu-item__inst { margin-top: 0.1rem; }

/* ── Skills ── */
.skills { display: flex; flex-wrap: wrap; gap: 0.6rem; }
.skill { border: 1px solid var(--ink-30); padding: 0.45em 1em; color: var(--ink-60); }
</style>
