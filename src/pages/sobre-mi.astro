---
import Layout from '../layouts/Layout.astro';
import * as cv from '../data/cv.md';
import { withBase, cvUrl } from '../site';
import { servicios, proceso, ahora, ahoraActualizado, recomendaciones } from '../data/about';

// Currículum: la fecha (<em>) pasa a la línea del <h3> y se reparte en una columna por bloque (h2)
const cvHtml = (await cv.compiledContent()).replace(
  /(<h3[^>]*>)([\s\S]*?)<\/h3>\s*<p><em>([\s\S]*?)<\/em><\/p>/g,
  '$1$2 <em>$3</em></h3>',
);
const cvCols = cvHtml.split(/(?=<h2)/).filter((col) => col.trim());
---

<Layout
  title="Sobre mí — Rafael Hijano"
  description="Diseñador Visual en Málaga. Graduado en Comunicación Audiovisual y Máster en Diseño Visual."
>
  <div class="page">
    <div class="container">

      <section class="intro">
  <h1 class="t-hero intro__title">Rafael Hijano, diseñador visual en Málaga</h1>

  <div class="intro__grid">
    <div class="intro__photo-wrap">
      <img
        src={withBase('images/about/about-profile.png')}
        alt="Rafael Hijano, diseñador visual y graduado en comunicación, en Málaga"
        class="intro__photo"
      />
    </div>

    <div class="intro__bio">
<p class="lead">
  Diseño, arte, alma y transparencia
</p>
<p class="t-body">
  Soy diseñador visual y graduado en comunicación, en Málaga. Mi trabajo es ayudar a las marcas a comunicar con claridad
  quiénes son y qué hacen por sus clientes. Busco proyectos exigentes en los que seguir creciendo, ya sea
  integrándome en el equipo de una agencia o estudio, o liderando la imagen de
  una empresa que quiere dar el siguiente paso.
</p>
<p class="t-body">
  Trabajo con identidad visual, branding y diseño gráfico, y me motiva
  acompañar a un negocio justo cuando funciona y necesita evolucionar: ese
  momento en que su imagen debe estar a la altura de su potencial.
</p>
<p class="t-body">
  Mi vocación nació de niño, fascinado por los videojuegos y los sistemas
  interactivos, y se consolidó en la universidad, donde descubrí que lo mío es
  contar historias a través del diseño. Fuera de él, me apasionan la psicología,
  la música, la tecnología y la cultura geek, y siempre busco algún gato que me
  alegre el día.
</p>
            <a href={withBase('contacto')} class="cta">Hablemos</a>
          </div>
        </div>
      </section>


      <!-- Servicios en detalle -->
      <div class="section-row">
        <section class="section" id="servicios">
          <h2 class="t-section section__title">Servicios</h2>

          {servicios.map((s) => (
            <article class="split">
              <div class="split__head">
                <h3 class="t-project-title">{s.title}</h3>
              </div>
              <div class="split__body">
                <p class="t-body">{s.detail}</p>
                <ul class="tag-list">
                  {s.items.map((item) => <li class="tag t-label">{item}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </section>

        <section class="section" id="proceso">
          <h2 class="t-section section__title">Proceso</h2>

          {proceso.map((step, i) => (
            <article class="split">
              <div class="split__head">
                <span class="t-label text-muted">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="t-project-title">{step.title}</h3>
              </div>
              <div class="split__body">
                <p class="t-body">{step.text}</p>
              </div>
            </article>
          ))}
        </section>
      </div>

      <!-- Imagen entre servicios/proceso y currículum -->
      <img
        src={withBase('images/about/about-cv.png')}
        alt=""
        class="section-banner"
      />

      <!-- CV generado desde src/data/cv.md -->
      <div class="section" id="cv">
        <div class="section-head">
          <h2 class="t-section">Currículum</h2>
          <a
            href={cvUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="cta"
          >
            Descargar CV
          </a>
        </div>

        <div class="cv-md">
          {cvCols.map((col) => (
            <div class:list={['cv-col', /habilidades/i.test(col.slice(0, 80)) && 'cv-col--skills']} set:html={col} />
          ))}
          <img
            src={withBase('images/about/about-formacion.png')}
            alt=""
            class="cv-img"
          />
        </div>
      </div>

      {recomendaciones.length > 0 && (
        <>
          <section class="section" id="recomendaciones">
            <img
              src={withBase('images/about/about-recomendaciones.png')}
              alt=""
              class="section__media"
            />

            <div class="section__content">
              <h2 class="t-section section__title">Recomendaciones</h2>

              {recomendaciones.map((r) => (
                <figure class="split">
                  <figcaption class="split__head">
                    <strong>{r.name}</strong>
                    <span class="t-label text-muted">{r.role}</span>
                  </figcaption>
                  <blockquote class="split__body">
                    <p class="t-body">{r.quote}</p>
                  </blockquote>
                </figure>
              ))}
            </div>
          </section>
        </>
      )}


      <!-- Ahora mismo -->
      <section class="section" id="ahora">
        <img
          src={withBase('images/about/about-ahora.png')}
          alt=""
          class="section__media"
        />

        <div class="section__content">
          <div class="section-head">
            <h2 class="t-section">Ahora mismo</h2>
            <p class="t-label text-muted">Actualizado: {ahoraActualizado}</p>
          </div>

          {ahora.map((item) => (
            <article class="split">
              <div class="split__head">
                <span class="t-label">{item.label}</span>
              </div>
              <div class="split__body">
                <p class="t-body">{item.text}</p>
              </div>
            </article>
          ))}

          <div class="cv-cta cv-cta--start">
            <a href={withBase('contacto')} class="cta">Hablemos</a>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>