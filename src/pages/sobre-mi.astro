---
import Layout from '../layouts/Layout.astro';
import AboutIntro from '../components/AboutIntro.astro';
import Cta from '../components/Cta.astro';
import CvSection from '../components/CvSection.astro';
import SectionHead from '../components/SectionHead.astro';
import SplitRow from '../components/SplitRow.astro';
import { withBase } from '../site';
import { ahora, ahoraActualizado, recomendaciones } from '../data/about';
---

<Layout
  title="Sobre mí: diseñador visual y gráfico en Málaga"
  description="Diseñador gráfico y visual en Málaga y en remoto. Graduado en Comunicación Audiovisual y máster en Diseño Visual, especializado en branding."
  image="images/about/about-profile.avif"
>
  <div class="page">
    <div class="container">
      <AboutIntro
        title="Rafael Hijano, diseñador gráfico y visual en Málaga"
        photo="images/about/about-profile.avif"
        photoAlt="Rafael Hijano, diseñador visual y graduado en comunicación, en Málaga"
      >
        <p class="t-lead">Diseño, arte, alma y transparencia</p>
        <p class="t-body">
          Soy diseñador gráfico y visual en Málaga, graduado en comunicación. Mi trabajo es ayudar a las marcas a comunicar con claridad
          quiénes son y qué hacen por sus clientes. Busco proyectos exigentes en los que seguir creciendo, ya sea
          integrándome en el equipo de una agencia o estudio, o liderando la imagen de
          una empresa que quiere dar el siguiente paso. Trabajo desde Málaga y alrededores, y también en remoto.
        </p>
        <p class="t-body">
          Trabajo con identidad visual, branding, diseño gráfico y motion graphics, y me motiva
          acompañar a un negocio justo cuando funciona y necesita evolucionar: ese
          momento en que su imagen debe estar a la altura de su potencial.
        </p>
        <p class="t-body">
          Mi vocación nació de niño, fascinado por los videojuegos y los sistemas
          interactivos, y se consolidó en la universidad, donde descubrí que lo mío es
          contar historias a través del diseño. Fuera de él, me apasionan la psicología,
          la música, la tecnología y la cultura geek, y siempre busco algún gato que me
          alegre el día.
        </p>
        <Cta href={withBase('contacto')}>Hablemos</Cta>
      </AboutIntro>

      <img src={withBase('images/about/about-cv.avif')} alt="" class="banner" loading="lazy" decoding="async" />

      <CvSection inline>
        <img src={withBase('images/about/about-formacion.avif')} alt="" class="cv__img" loading="lazy" decoding="async" />
      </CvSection>

      {recomendaciones.length > 0 && (
        <section class="section" id="recomendaciones">
          <img src={withBase('images/about/about-recomendaciones.avif')} alt="" class="section__media" loading="lazy" decoding="async" />

          <div class="section__content">
            <SectionHead title="Recomendaciones" />

            {recomendaciones.map(({ name, role, quote }) => (
              <SplitRow as="figure" headAs="figcaption" bodyAs="blockquote">
                <Fragment slot="head">
                  <strong>{name}</strong>
                  <span class="t-label t-muted">{role}</span>
                </Fragment>
                <p class="t-body">{quote}</p>
              </SplitRow>
            ))}
          </div>
        </section>
      )}

      <section class="section" id="ahora">
        <img src={withBase('images/about/about-ahora.avif')} alt="" class="section__media" loading="lazy" decoding="async" />

        <div class="section__content">
          <SectionHead title="Ahora mismo">
            <p class="t-label t-muted">Actualizado: {ahoraActualizado}</p>
          </SectionHead>

          {ahora.map(({ label, text }) => (
            <SplitRow>
              <span slot="head" class="t-label">{label}</span>
              <p class="t-body">{text}</p>
            </SplitRow>
          ))}

          <Cta href={withBase('contacto')} class="section__cta">Hablemos</Cta>
        </div>
      </section>
    </div>
  </div>
</Layout>
