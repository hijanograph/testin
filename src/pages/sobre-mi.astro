---
import Layout from '../layouts/Layout.astro';
import { Content as CvContent } from '../data/cv.md';
import { withBase } from '../utils/base';
import { servicios, proceso } from '../data/servicios';
import { ahora, ahoraActualizado } from '../data/ahora';
import { recomendaciones } from '../data/recomendaciones';
import { cvDownloadUrl } from '../data/cv';
---

<Layout
  title="Sobre mí — Rafael Hijano"
  description="Diseñador Visual en Málaga. Graduado en Comunicación Audiovisual y Máster en Diseño Visual."
>
  <div class="page">
    <div class="container">

      <section class="intro">
        <h1 class="t-hero intro__title">Sobre mí</h1>

        <div class="intro__grid">
          <div class="intro__photo-wrap">
            <img
              src={withBase('images/about/about-profile.png')}
              alt="Rafael Hijano"
              class="intro__photo"
            />
          </div>

          <div class="intro__bio">
            <!-- Propuesta de valor -->
            <p class="lead">
              Diseño identidades visuales con alma para marcas que quieren contar bien su historia, desde la idea hasta el último soporte.
            </p>

            <p class="t-body">
              Soy Rafael, un Diseñador Visual que vive y trabaja en el área de Málaga.
              Me apasiona crear espacios donde las marcas cobran vida y construir proyectos
              con alma, conectando con las personas a través de un diseño cuidado y con propósito.
            </p>
            <p class="t-body">
              Soy graduado de la Universidad de Málaga en Comunicación Audiovisual y cuento con
              un Máster en Diseño Visual de La X Gauss. Mi interés por el diseño nació de forma
              natural: de niño me fascinaban los sistemas interactivos y el arte visual en los
              videojuegos y los ordenadores, lo que me llevó a querer estudiar informática.
              Aunque sabía que mi hábitat se encontraba entre interfaces, algo dentro de mí me
              pedía explorar más mi lado creativo.
            </p>
            <p class="t-body">
              Así fue cómo comencé por segunda vez mi etapa universitaria, y tras explorar la
              comunicación en todas sus formas, descubrí que mi verdadera vocación era contar
              historias a través del diseño visual.
            </p>
            <p class="t-body">
              Actualmente, trabajo como Diseñador Visual en Batterylight. Lidero diferentes
              áreas creativas dentro del departamento de marketing, desde el diseño de packaging
              hasta la edición de catálogos.
            </p>
            <p class="t-body">
              Fuera del diseño, soy un entusiasta de la psicología, la música, la tecnología y
              la cultura geek en general. Cuando tengo tiempo libre, puedes encontrarme leyendo,
              jugando, cocinando, viendo alguna serie o acariciando algún gato.
            </p>
          </div>
        </div>
      </section>

      <hr />

      <!-- Servicios en detalle -->
      <section class="section" id="servicios">
        <h2 class="t-section section__title">Servicios</h2>

        {servicios.map((s) => (
          <article class="split">
            <div class="split__head">
              <h3 class="t-project-title">{s.title}</h3>
            </div>
            <div class="split__body">
              <p class="t-body">{s.detail}</p>
              <ul class="tag-list">
                {s.items.map((item) => <li class="tag t-label">{item}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </section>

      <hr />

      <!-- Proceso -->
      <section class="section" id="proceso">
        <h2 class="t-section section__title">Proceso</h2>

        {proceso.map((step, i) => (
          <article class="split">
            <div class="split__head">
              <span class="t-label text-muted">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="t-project-title">{step.title}</h3>
            </div>
            <div class="split__body">
              <p class="t-body">{step.text}</p>
            </div>
          </article>
        ))}
      </section>

      <hr />

      <!-- CV generado desde src/data/cv.md -->
      <section class="section" id="cv">
        <div class="section-head">
          <h2 class="t-section">Currículum</h2>
          <a
            href={cvDownloadUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="download-btn t-label"
          >
            Descargar CV ↓
          </a>
        </div>

        <div class="cv-md">
          <CvContent />
        </div>
      </section>

      {recomendaciones.length > 0 && (
        <>
          <hr />

          <section class="section" id="recomendaciones">
            <h2 class="t-section section__title">Recomendaciones</h2>

            {recomendaciones.map((r) => (
              <figure class="split">
                <figcaption class="split__head">
                  <strong>{r.name}</strong>
                  <span class="t-label text-muted">{r.role}</span>
                </figcaption>
                <blockquote class="split__body quote">
                  <p class="t-body">{r.quote}</p>
                </blockquote>
              </figure>
            ))}
          </section>
        </>
      )}

      <hr />

      <!-- Ahora mismo -->
      <section class="section" id="ahora">
        <div class="section-head">
          <h2 class="t-section">Ahora mismo</h2>
          <p class="t-label text-muted">Actualizado: {ahoraActualizado}</p>
        </div>

        {ahora.map((item) => (
          <article class="split">
            <div class="split__head">
              <span class="t-label">{item.label}</span>
            </div>
            <div class="split__body">
              <p class="t-body">{item.text}</p>
            </div>
          </article>
        ))}

        <div class="cv-cta cv-cta--start">
          <a href={withBase('contacto')} class="download-btn t-label">Hablemos</a>
        </div>
      </section>

    </div>
  </div>
</Layout>
