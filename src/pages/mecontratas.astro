---
import Layout from '../layouts/Layout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getProjects } from '../data/projects';
import { getCvColumns } from '../data/cv-columns';
import { email, socials, downloads, cvUrl, withBase } from '../site';

const projects = await getProjects({ featured: true });
const cvColumns = await getCvColumns();

const profile = [
  { label: 'Perfil', value: 'Diseñador gráfico y visual, especializado en branding, motion graphics y edición de vídeo' },
  { label: 'Ubicación', value: 'Málaga, España. Disponible en Málaga y alrededores o en remoto' },
  { label: 'Última experiencia', value: 'Diseñador visual en Batterylight (feb 2025 — feb 2026)' },
  { label: 'Formación', value: 'Máster en Diseño Visual (La X Gauss) y Grado en Comunicación Audiovisual (Universidad de Málaga)' },
];

const links = [...downloads, ...socials.filter((s) => s.label !== 'Instagram')];
---

<Layout
  title="Me encantaría trabajar contigo"
  description="Perfil, currículum, proyectos y contacto de Rafael Hijano, diseñador gráfico y visual en Málaga y en remoto."
  noindex
>
  <div class="page">
    <div class="container">
      <section class="intro stack">
        <p class="t-label t-muted">Para reclutadores</p>
        <h1 class="t-hero page-title">Me encantaría trabajar contigo</h1>
        <div class="measure stack">
          <p class="t-lead">Si has recibido este enlace, es porque tengo un interés real en la oferta.</p>
          <p class="t-body">
            He reunido aquí lo esencial para conocerme rápido: quién soy, dónde he trabajado,
            qué sé hacer y cómo contactar conmigo. Si necesitas algo más, escríbeme y te respondo enseguida.
          </p>
          <a href={`mailto:${email}`} class="cta">Escríbeme</a>
        </div>
      </section>

      <section class="section" id="esencial">
        <h2 class="t-section section__title">Lo esencial</h2>
        <dl class="facts">
          {profile.map((item) => (
            <div>
              <dt class="t-label t-muted">{item.label}</dt>
              <dd class="t-body">{item.value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <div class="section" id="cv">
        <div class="section__head">
          <h2 class="t-section">Currículum</h2>
          <a href={cvUrl} target="_blank" rel="noopener noreferrer" class="cta">Descargar CV</a>
        </div>

        <div class="cv">
          {cvColumns.map((col) => <div class={`cv__col cv__col--${col.kind}`} set:html={col.html} />)}
        </div>
      </div>

      <section class="section" id="proyectos">
        <div class="section__head">
          <h2 class="t-section">Proyectos destacados</h2>
          <a href={withBase('proyectos')} class="cta">Ver todos</a>
        </div>
        <ProjectGrid projects={projects} />
      </section>

      <section class="section stack" id="contacto">
        <h2 class="t-section section__title">Hablemos</h2>
        <a href={`mailto:${email}`} class="big-email">{email}</a>
        <ul class="link-list">
          {links.map((l) => (
            <li><a href={l.href} target="_blank" rel="noopener noreferrer" class="cta">{l.label}</a></li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Layout>
