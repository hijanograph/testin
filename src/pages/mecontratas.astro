---
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
import ContactSection from '../components/ContactSection.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import CvSection from '../components/CvSection.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectBrowser from '../components/ProjectBrowser.astro';
import SectionHead from '../components/SectionHead.astro';
import { getProjects } from '../data/projects';
import { esencial, introPorDefecto, introPorArea } from '../data/mecontratas';
import { email, downloads, professionalSocials, withBase } from '../site';

const projects = await getProjects({ featured: true });
const links = [...downloads, ...professionalSocials];
---

<Layout
  title="Me encantaría trabajar contigo"
  description="Perfil, currículum, proyectos y contacto de Rafael Hijano, diseñador gráfico y visual en Málaga y en remoto."
  noindex
>
  <div class="page">
    <div class="container">
      <PageIntro eyebrow="Para reclutadores" title={introPorDefecto.title}>
        <p class="t-lead">{introPorDefecto.lead}</p>
        <p class="t-body">{introPorDefecto.body}</p>
        <Cta href={`mailto:${email}`}>Escríbeme</Cta>
      </PageIntro>

      <HeroCarousel projects={projects} />

      <section class="section" id="esencial">
        <SectionHead title="Lo esencial" />
        <dl class="facts">
          {esencial.map(({ label, value }) => (
            <div class="facts__item">
              <dt class="t-label t-muted">{label}</dt>
              <dd class="t-body">{value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="section" id="proyectos">
        <SectionHead title="Proyectos destacados">
          <Cta href={withBase('proyectos')}>Ver todos</Cta>
        </SectionHead>
        <ProjectBrowser projects={projects} lockOnHash />
      </section>

      <CvSection />

      <ContactSection title="Hablemos" links={links} />
    </div>
  </div>

  <script
    type="application/json"
    id="intro-variants"
    set:html={JSON.stringify({ default: introPorDefecto, ...introPorArea })}
  />
</Layout>

<script>
  import '../scripts/area-intro';
</script>
