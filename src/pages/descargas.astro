---
import Layout from '../layouts/Layout.astro';

const driveView = (id) => `https://drive.google.com/file/d/${id}/preview`;
const driveDownload = (id) => `https://drive.google.com/uc?export=download&id=${id}`;

const documents = [
  {
    id: '16K_kHrIxXQuXzdytIGrX46_dsheItNwA',
    title: 'Currículum',
    meta: 'PDF — Actualizado',
    iframeTitle: 'Currículum de Rafael Hijano',
    cta: 'Descargar Currículum (PDF) ↓',
  },
  {
    id: 'TU_ID_DE_PORTFOLIO_EN_DRIVE',
    title: 'Portfolio',
    meta: 'PDF — Proyectos seleccionados',
    iframeTitle: 'Portfolio de Rafael Hijano',
    cta: 'Descargar Portfolio (PDF) ↓',
  },
];
---

<Layout
  title="Descargas — Rafael Hijano"
  description="Descarga el currículum y el portfolio de Rafael Hijano, Diseñador Visual."
>
  <main class="page">
    <div class="container">

      <header class="downloads-header">
        <h1 class="t-hero">Descargas</h1>
        <p class="t-body downloads-subtitle">
          Accede y descarga directamente mi currículum actualizado y mi portfolio profesional.
        </p>
      </header>

      {documents.map((d, i) => (
        <Fragment>
          {i > 0 && <hr class="section-divider" />}

          <section class="download-section">
            <div class="section-title-wrap">
              <h2 class="t-section">{d.title}</h2>
              <span class="t-label">{d.meta}</span>
            </div>

            <div class="pdf-viewer pdf-viewer--compact">
              <iframe src={driveView(d.id)} title={d.iframeTitle}></iframe>
            </div>

            <div class="cv-cta">
              <a
                href={driveDownload(d.id)}
                target="_blank"
                rel="noopener noreferrer"
                class="download-btn t-label"
              >
                {d.cta}
              </a>
            </div>
          </section>
        </Fragment>
      ))}

    </div>
  </main>
</Layout>