---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../site';

const projects = (await getCollection('portfolio', (p) => p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="Rafael Hijano — Diseñador Visual">
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__img-wrap">
        <img src={withBase('images/index/hero-profile.png')} alt="Rafael Hijano" class="hero__img" fetchpriority="high" />
      </div>

      <div class="hero__text">
        <h1 class="t-hero">Hola, soy Rafael Hijano</h1>
        <p class="t-body">
          Diseño identidades visuales que tienen algo que decir. Creo en los detalles que importan, en las historias bien contadas y en el diseño que perdura.
          Si estás buscando a alguien para tu proyecto, creo que tenemos algo de qué hablar.
        </p>
      </div>
    </div>
  </section>

  <section class="projects">
    <div class="container">
      <h2 class="t-section projects__heading">Algunos de mis proyectos:</h2>
      <div class="projects__grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</Layout>
