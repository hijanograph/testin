---
import Layout from '../layouts/Layout.astro';

const projects = [
  {
    slug: 'arbocala',
    title: 'Una marca viva, pero con historia',
    desc: 'Creación de un ecosistema visual para Bodegas Arbocala y sus productos derivados',
    img: '/images/projects/arbocala-cover.jpg',
    imgAlt: 'Bodegas Arbocala — branding',
  },
  {
    slug: 'fiambre',
    title: 'El alma del terror cotidiano',
    desc: 'Una identidad visual integral cercana y diferente, con espíritu innovador para la editorial multiplataforma Fiambre',
    img: '/images/projects/fiambre-cover.jpg',
    imgAlt: 'Editorial Fiambre — branding',
  },
  {
    slug: 'andaluce',
    title: 'Música, arte y tradición',
    desc: 'Tributo a «ANDALUÇÊ YORÁ», de Califato ¾ (aún en proceso)',
    img: '/images/projects/andaluce-cover.jpg',
    imgAlt: 'Andaluçê yorá — ilustración',
    wip: true,
  },
];
---

<Layout title="Rafael Hijano — Diseñador Visual">

  <section class="hero">
    <div class="container hero__inner">

      <div class="hero__img-wrap">
        <div class="img-ph hero__img"></div>
      </div>

      <div class="hero__text">
        <h1 class="t-hero">El diseñador de la historia visual de tu marca</h1>
        <p class="t-body hero__bio">
          Me llamo Rafael Hijano. Soy un diseñador visual que crea espacios
          donde cada marca cobra vida. Mi propósito es construir conexiones
          con alma que aseguren que cada elemento tenga la profundidad
          suficiente para contar su propia historia.
        </p>
      </div>

    </div>
  </section>

  <section class="projects">
    <div class="container">

      <h2 class="t-section projects__heading">Proyectos</h2>

      <div class="projects__grid">
        {projects.map((p) => (
          <article class="project-card">
            <a href={`/portfolio/${p.slug}`} class="project-card__img-link">
              <div class="img-ph project-card__img"></div>
              {p.wip && <span class="project-card__wip badge t-label">En proceso</span>}
            </a>
            <div class="project-card__body">
              <a href={`/portfolio/${p.slug}`}>
                <h3 class="t-project-title project-card__title">{p.title}</h3>
              </a>
              <p class="t-body project-card__desc">{p.desc}</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

</Layout>