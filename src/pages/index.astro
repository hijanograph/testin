---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') 
  ? import.meta.env.BASE_URL 
  : `${import.meta.env.BASE_URL}/`;

const projects = [
  {
    slug: 'arbocala',
    title: 'Bodegas Arbocala',
    desc: 'Creación de un ecosistema visual para Bodegas Arbocala y sus productos derivados. Una marca viva, pero con historia.',
    img: `${base}images/index/arbocala-cover.png`,
    imgAlt: 'Bodegas Arbocala — branding',
  },
  {
    slug: 'fiambre',
    title: 'Editorial Fiambre',
    desc: 'Una identidad visual integral cercana y diferente, con espíritu innovador para la editorial multiplataforma Fiambre, que busca ser «el alma del terror cotidiano».',
    img: `${base}images/index/fiambre-cover.png`,
    imgAlt: 'Editorial Fiambre — branding',
  },
  {
    slug: 'andaluce',
    title: 'Andaluçê yorá',
    desc: 'Tributo a «ANDALUÇÊ YORÁ», de Califato ¾. Una mezcla de música, arte y tradición con toques de actualidad.',
    img: `${base}images/index/andaluce-cover.gif`,
    imgAlt: 'Andaluçê yorá — ilustración',
    wip: true,
  },
];
---

<Layout title="Rafael Hijano — Diseñador Visual">

  <section class="hero">
  <div class="hero__inner">

    <div class="hero__img-wrap">
      <img
        src={`${base}images/index/hero-profile.png`}
        alt="Rafael Hijano"
        class="hero__img"
      />
    </div>

    <div class="hero__text">
      <h1 class="t-hero">Hola, soy Rafael Hijano</h1>
      <p class="t-body hero__bio">
        Diseño identidades visuales que tienen algo que decir. Creo en los detalles que importan, en las historias bien contadas y en el diseño que perdura.
        Si estás buscando a alguien para tu proyecto, creo que tenemos algo de qué hablar.
      </p>
    </div>

  </div>
</section>

  <section class="projects">
    <div class="container">

      <h2 class="t-section projects__heading">Algunos de mis proyectos:</h2>

      <div class="projects__grid">
        {projects.map((p) => (
          <article class="project-card">
            <a href={`${base}portfolio/${p.slug}`} class="project-card__img-link">
              <img src={p.img} alt={p.imgAlt} class="project-card__img" />
              {p.wip && <span class="project-card__wip badge t-label">En proceso</span>}
            </a>
            <div class="project-card__body">
              <a href={`${base}portfolio/${p.slug}`}>
                <h3 class="t-project-title project-card__title">{p.title}</h3>
              </a>
              <p class="t-body project-card__desc">{p.desc}</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

</Layout>