---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProyectos } from '../utils/proyectos';
import { servicios } from '../data/servicios';
import { withBase } from '../utils/base';
import { email } from '../utils/links';

const [user, domain] = email.split('@');
const featured = (await getProyectos()).filter((p) => p.data.featured);
---

<Layout title="Rafael Hijano — Diseñador Visual">

  <section class="hero">
    <div class="hero__inner">

      <div class="hero__img-wrap">
        <img
          src={withBase('images/index/hero-profile.png')}
          alt="Rafael Hijano"
          class="hero__img"
        />
      </div>

      <div class="hero__text">
        <p class="t-label text-muted">Diseñador visual — Branding, editorial y motion</p>
        <h1 class="t-hero">Hola, soy Rafael Hijano</h1>
        <p class="t-body hero__bio">
          Diseño identidades visuales que tienen algo que decir. Creo en los detalles que importan, en las historias bien contadas y en el diseño que perdura.
          Si estás buscando a alguien para tu proyecto, creo que tenemos algo de qué hablar.
        </p>

        <div class="hero__cta">
          <p class="t-label">¿Hablamos?</p>
          <a href={`mailto:${email}`} class="big-email">
            {user}@<br />
            {domain}
          </a>
        </div>
      </div>

    </div>
  </section>

  <section class="projects">
    <div class="container">

      <div class="section-head">
        <h2 class="t-section">Proyectos seleccionados</h2>
        <a href={withBase('proyectos')} class="arrow-link">Ver todos</a>
      </div>

      <div class="projects__grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>

    </div>
  </section>

  <section class="services">
    <div class="container">

      <div class="section-head">
        <h2 class="t-section">Servicios</h2>
        <a href={withBase('sobre-mi#servicios')} class="arrow-link">En detalle</a>
      </div>

      <div class="services__grid">
        {servicios.map((s) => (
          <article class="service">
            <h3 class="t-project-title">{s.title}</h3>
            <p class="t-body">{s.summary}</p>
          </article>
        ))}
      </div>

    </div>
  </section>

</Layout>