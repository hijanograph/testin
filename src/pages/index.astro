---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../data/projects';
import { withBase } from '../site';

const projects = await getProjects({ featured: true });
---

<Layout>
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__img-wrap">
        <img src={withBase('images/index/hero-profile.png')} alt="Rafael Hijano" class="hero__img" fetchpriority="high" decoding="async" />
      </div>

      <div class="hero__text">
        <h1 class="t-hero">Hola, soy<br />Rafael Hijano</h1>
        <p class="t-label t-muted">DISEÑADOR VISUAL — DISEÑADOR GRÁFICO — MOTION GRAPHICS</p>
        <p class="t-body">
          Diseño identidades visuales que tienen algo que decir. Creo en los detalles que importan, en las historias bien contadas y en el diseño que perdura.
          Si estás buscando a alguien para tu proyecto, creo que tenemos algo de qué hablar.
        </p>
        <a href={withBase('contacto')} class="cta">Hablemos</a>
      </div>
    </div>
  </section>

  <section class="projects">
    <div class="container">
      <h2 class="t-section section__title">Algunos de mis proyectos:</h2>
      <div class="projects__grid">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</Layout>
