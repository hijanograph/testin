---
// Reemplazo de src/pages/portfolio/[slug].astro usando Storyblok en vez de content collections
import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

export async function getStaticPaths() {
  const storyblokApi = useStoryblokApi();
  const { data } = await storyblokApi.get('cdn/stories', {
    starts_with: 'portfolio/',
    version: 'draft',
  });

  return data.stories.map((story) => ({
    params: { slug: story.slug },
  }));
}

const { slug } = Astro.params;
const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get(`cdn/stories/portfolio/${slug}`, {
  version: 'draft',
  resolve_relations: 'portfolio_project.prev_project,portfolio_project.next_project',
});
const { story } = data;
---

<StoryblokComponent blok={story.content} />
