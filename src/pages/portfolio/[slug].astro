---
import Layout from '../../layouts/Layout.astro';
import ProjectLayout from '../../components/ProjectLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MusicEmbed from '../../components/MusicEmbed.astro';
import { withBase } from '../../utils/base';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio');

  return projects.map((project: CollectionEntry<'portfolio'>) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project }: { project: CollectionEntry<'portfolio'> } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const asset = (path?: string) => (path ? withBase(path) : undefined);
---

<Layout
  title={`${d.title} — Rafael Hijano`}
  description={d.desc}
>
  <ProjectLayout
    title={d.title}
    subtitle={d.subtitle}
    area={d.area}
    rol={d.rol}
    software={d.software}
    heroImg={asset(d.heroImg)}
    heroAlt={d.heroAlt}
    prevHref={d.prevSlug ? withBase(`portfolio/${d.prevSlug}`) : undefined}
    prevLabel={d.prevLabel}
    nextHref={d.nextSlug ? withBase(`portfolio/${d.nextSlug}`) : undefined}
    nextLabel={d.nextLabel}
  >
    {d.wip ? (
      <>
        <div class="wip-media">
          <img
            src={withBase('images/projects/andaluce-wip.gif')}
            alt={`${d.title} — en proceso`}
            class="wip-figure"
          />
          {d.musicId && <MusicEmbed videoId={d.musicId} />}
        </div>
        <div class="wip-text">
          <p class="t-label wip-tag">Proyecto bajo construcción</p>
          <Content />
        </div>
      </>
    ) : (
      <div class="project-body">
        <Content />
      </div>
    )}
  </ProjectLayout>
</Layout>