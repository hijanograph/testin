---
import Layout from '../../layouts/Layout.astro';
import ProjectLayout from '../../components/ProjectLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio');

  return projects.map((project: CollectionEntry<'portfolio'>) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project }: { project: CollectionEntry<'portfolio'> } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const asset = (path?: string) => {
  if (!path) return undefined;
  const clean = path.replace('${base}', '').replace(/^\/?public\//, '');
  if (clean.startsWith(base)) return clean;
  return `${base}${clean.replace(/^\/+/, '')}`;
};
---

<Layout
  title={`${d.title} — Rafael Hijano`}
  description={d.desc}
>
  <ProjectLayout
    title={d.title}
    subtitle={d.subtitle}
    area={d.area}
    rol={d.rol}
    software={d.software}
    heroImg={asset(d.heroImg)}
    heroAlt={d.heroAlt}
    prevHref={d.prevSlug ? `${base}portfolio/${d.prevSlug}` : undefined}
    prevLabel={d.prevLabel}
    nextHref={d.nextSlug ? `${base}portfolio/${d.nextSlug}` : undefined}
    nextLabel={d.nextLabel}
  >
    {d.wip ? (
      <>
        <img
          src={`${base}images/projects/andaluce-wip.gif`}
          alt={`${d.title} — en proceso`}
          class="wip-figure"
        />
        <div class="wip-text">
          <p class="t-label wip-tag">Proyecto bajo construcción</p>
          <Content />
        </div>
      </>
    ) : (
      <div class="project-body">
        <Content />
      </div>
    )}
  </ProjectLayout>
</Layout>