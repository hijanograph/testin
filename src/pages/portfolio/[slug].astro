---
import Layout from '../../layouts/Layout.astro';
import ProjectLayout from '../../components/ProjectLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('portfolio');
  return projects.map((project) => ({
    params: { slug: project.id },
    props:  { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<Layout
  title={`${d.title} — Rafael Hijano`}
  description={d.desc}
>
  <ProjectLayout
    title={d.title}
    subtitle={d.subtitle}
    area={d.area}
    rol={d.rol}
    software={d.software}
    heroImg={d.heroImg}
    heroAlt={d.heroAlt}
    prevHref={d.prevSlug ? `/portfolio/${d.prevSlug}` : undefined}
    prevLabel={d.prevLabel}
    nextHref={d.nextSlug ? `/portfolio/${d.nextSlug}` : undefined}
    nextLabel={d.nextLabel}
    wip={d.wip}
  >
    {d.wip && (
      <div class="wip-block">
        <div class="wip-figure" aria-hidden="true">
          <svg viewBox="0 0 100 140" xmlns="http://www.w3.org/2000/svg" width="80">
            <circle cx="50" cy="22" r="16" fill="currentColor" opacity="0.18"/>
            <path d="M22 140 Q35 88 50 68 Q65 88 78 140" fill="currentColor" opacity="0.14"/>
            <path d="M20 78 Q10 100 16 118" stroke="currentColor" stroke-width="6" fill="none" stroke-linecap="round" opacity="0.1"/>
            <path d="M80 78 Q90 100 84 118" stroke="currentColor" stroke-width="6" fill="none" stroke-linecap="round" opacity="0.1"/>
          </svg>
        </div>
        <div class="wip-text">
          <p class="t-label wip-tag">Proyecto bajo construcción</p>
          <Content />
        </div>
      </div>
    )}

    {!d.wip && (
      <div class="project-body">
        <Content />
      </div>
    )}
  </ProjectLayout>
</Layout>

<style>
/* ── WIP block ── */
.wip-block {
  display: flex;
  align-items: flex-start;
  gap: 2rem;
  flex-wrap: wrap;
  padding: 2.5rem;
  border: 1px solid var(--ink-10);
  max-width: 72ch;
}
.wip-figure { color: var(--ink); flex-shrink: 0; opacity: 0.5; }
.wip-text { display: flex; flex-direction: column; gap: 0.75rem; }
.wip-tag { margin-bottom: 0.25rem; }

/* ── Prose del proyecto (renderizado desde Markdown) ── */
.project-body {
  display: flex;
  flex-direction: column;
  gap: 3rem;
  max-width: 72ch;
}

/* Astro renderiza el markdown con etiquetas estándar; las estilamos aquí */
.project-body :global(h2) {
  font-size: clamp(1.5rem, 3vw, 2.2rem);
  font-weight: 700;
  letter-spacing: -0.015em;
  line-height: 1.1;
  margin-bottom: 1rem;
}
.project-body :global(p) {
  font-size: clamp(0.875rem, 1.4vw, 0.95rem);
  font-weight: 400;
  line-height: 1.7;
  color: var(--ink-60);
  max-width: 70ch;
}
.project-body :global(p + p) { margin-top: 1rem; }

/* Imágenes dentro del markdown */
.project-body :global(img) {
  width: 100%;
  display: block;
  margin: 1rem 0;
}
</style>
