---
import Layout from '../../layouts/Layout.astro';
import ProjectLayout from '../../components/ProjectLayout.astro';
---

<Layout title="Andaluçê yorá — Rafael Hijano" description="Tributo a «ANDALUÇÊ YORÁ» de Califato ¾ — proyecto en proceso.">
  <ProjectLayout
    title="Andaluçê yorá"
    subtitle="(hierofanía de los moriscos y el expolio andaluz)"
    area="Ilustración — Motion Graphics"
    rol="Director creativo — Motion grapher"
    software="Illustrator — After Effects"
    heroImg="/images/projects/andaluce-hero.jpg"
    heroAlt="Andaluçê yorá — ilustración"
    prevHref="/portfolio/fiambre"
    prevLabel="Editorial Fiambre"
    wip={true}
  >

    <!-- WIP state -->
    <div class="wip-block">
      <div class="wip-figure" aria-hidden="true">
        <svg viewBox="0 0 100 140" xmlns="http://www.w3.org/2000/svg" width="80">
          <circle cx="50" cy="22" r="16" fill="currentColor" opacity="0.18"/>
          <path d="M22 140 Q35 88 50 68 Q65 88 78 140" fill="currentColor" opacity="0.14"/>
          <path d="M20 78 Q10 100 16 118" stroke="currentColor" stroke-width="6" fill="none" stroke-linecap="round" opacity="0.1"/>
          <path d="M80 78 Q90 100 84 118" stroke="currentColor" stroke-width="6" fill="none" stroke-linecap="round" opacity="0.1"/>
        </svg>
      </div>
      <div class="wip-text">
        <p class="t-label wip-tag">Proyecto bajo construcción</p>
        <p class="t-body">
          Este proyecto es un tributo visual a <em>«ANDALUÇÊ YORÁ»</em> de Califato ¾,
          explorando la hierofanía morisca y el expolio andaluz a través de ilustración
          y motion graphics. Próximamente disponible.
        </p>
      </div>
    </div>

    <!-- Hero image placeholder (repetida del cover) -->
    <div class="img-ph img-ph--wide"></div>

  </ProjectLayout>
</Layout>

<style>
.wip-block {
  display: flex;
  align-items: flex-start;
  gap: 2rem;
  flex-wrap: wrap;
  padding: 2.5rem;
  border: 1px solid var(--ink-10);
  max-width: 72ch;
}

.wip-figure {
  color: var(--ink);
  flex-shrink: 0;
  opacity: 0.5;
}

.wip-text {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.wip-tag { margin-bottom: 0.25rem; }

.wip-text em {
  font-style: italic;
  color: var(--ink);
}
</style>
