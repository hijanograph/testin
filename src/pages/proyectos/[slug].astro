---
import Layout from '../../layouts/Layout.astro';
import ProjectSection from '../../components/project/ProjectSection.astro';
import Lightbox from '../../components/project/Lightbox.astro';
import ProjectNav from '../../components/project/ProjectNav.astro';
import type { CollectionEntry } from 'astro:content';
import { getProjectPages, getSubprojects } from '../../data/projects';
import { getGallery } from '../../data/gallery';
import { projectSchema } from '../../data/seo';
import { withBase } from '../../site';

export async function getStaticPaths() {
  const projects = await getProjectPages();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<'portfolio'> };
const { title, desc, heroImg, coverImg } = project.data;

// El proyecto y sus subproyectos comparten una sola galería: el visor recorre las fotos de todos, en orden,
// así que cada sección sabe cuántas fotos hay antes de la suya.
const projects = [project, ...(await getSubprojects(project.id))];
const galleries = await Promise.all(projects.map((p) => getGallery(p)));
const total = galleries.reduce((sum, images) => sum + images.length, 0);
// Todas las casillas del grid tienen la misma proporción, para que las filas midan lo mismo; 4/3 es la más cercana
// a la de las fotos de los proyectos (la foto rellena la casilla y en el visor siempre se ve entera)
const ratio = '4 / 3';
const slides = projects.flatMap((p, i) =>
  galleries[i].map((image, n) => ({ src: withBase(image.src), alt: image.alt || `${p.data.title} - imagen ${n + 1}` })),
);
let offset = 0;
const sections = projects.map((p, i) => {
  const section = { project: p, gallery: galleries[i], offset };
  offset += galleries[i].length;
  return section;
});
---

<Layout title={title} description={desc} image={heroImg ?? coverImg} schema={projectSchema(project, Astro.site, Astro.url.pathname)}>
  <div class="page">
    <div class="container">
      {sections.map((section, i) => (
        <ProjectSection {...section} total={total} ratio={ratio} sub={i > 0} />
      ))}

      <ProjectNav />
    </div>
  </div>

  {total > 0 && <Lightbox slides={slides} />}
</Layout>
