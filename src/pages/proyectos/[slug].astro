---
import Layout from '../../layouts/Layout.astro';
import ProjectHero from '../../components/project/ProjectHero.astro';
import ProjectVideo from '../../components/project/ProjectVideo.astro';
import ProjectWip from '../../components/project/ProjectWip.astro';
import ProjectBlocks from '../../components/project/ProjectBlocks.astro';
import ProjectGallery from '../../components/project/ProjectGallery.astro';
import ProjectNav from '../../components/project/ProjectNav.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getProjects } from '../../data/projects';
import { getGallery } from '../../data/gallery';
import { projectSchema } from '../../data/seo';
import { imageSize } from '../../utils/image-size';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<'portfolio'> };
const { title, desc, heroImg, coverImg, wipImg, wip, blocks, musicId, videoUrl, videoRatio } = project.data;
const { Content } = await render(project);

const [heroSize, ...blockSizes] = await Promise.all([imageSize(heroImg), ...blocks.map((block) => imageSize(block.image))]);
const gallery = await getGallery(project.id, [heroImg, coverImg, wipImg, ...blocks.map((block) => block.image)]);
---

<Layout title={title} description={desc} image={heroImg ?? coverImg} schema={projectSchema(project, Astro.site, Astro.url.pathname)}>
  <div class="page">
    <div class="container">
      <ProjectHero project={project} heroSize={heroSize} />

      <div class="project-content">
        {videoUrl && <ProjectVideo title={title} url={videoUrl} ratio={videoRatio} />}

        {wip ? (
          <ProjectWip title={title} image={wipImg} musicId={musicId}><Content /></ProjectWip>
        ) : blocks.length > 0 ? (
          <ProjectBlocks blocks={blocks} sizes={blockSizes} />
        ) : (
          <div class="project-prose"><Content /></div>
        )}

        {gallery.length > 0 && <ProjectGallery title={title} images={gallery} />}
      </div>

      <ProjectNav />
    </div>
  </div>
</Layout>
