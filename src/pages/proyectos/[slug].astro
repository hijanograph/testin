---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { withBase } from '../../site';
import { imageSize } from '../../image-size';

export async function getStaticPaths() {
  const all = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);

  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: all[i - 1], next: all[i + 1] },
  }));
}

type Entry = CollectionEntry<'portfolio'>;
const { project, prev, next } = Astro.props as { project: Entry; prev?: Entry; next?: Entry };
const d = project.data;
const { Content } = await render(project);

const [heroSize, ...blockSizes] = await Promise.all([
  imageSize(d.heroImg),
  ...d.blocks.map((b) => imageSize(b.image)),
]);

const cap = (v?: string) => v && v[0].toUpperCase() + v.slice(1);
const meta = [
  { label: 'Tipo', value: cap(d.tipo) },
  { label: 'Año', value: d.year },
  { label: 'Área', value: d.area },
  { label: 'Rol', value: d.rol },
  { label: 'Software', value: d.software },
].filter((m) => m.value);

const musicParams = d.musicId
  ? new URLSearchParams({ controls: '1', playsinline: '1', loop: '1', playlist: d.musicId, rel: '0', modestbranding: '1' })
  : '';
---

<Layout title={`${d.title} — Rafael Hijano`} description={d.desc}>
  <div class="page">
    <div class="container">

      <section class="project-hero">
        <div class="project-hero__img-wrap">
          {d.heroImg ? (
            <img
              src={withBase(d.heroImg)}
              alt={d.heroAlt || d.title}
              width={heroSize?.width}
              height={heroSize?.height}
              fetchpriority="high"
              decoding="async"
              class="project-hero__img"
            />
          ) : (
            <div class="img-ph img-ph--wide project-hero__img"></div>
          )}
        </div>

        <div class="project-hero__info">
          <div>
            <h1 class="t-hero project-hero__title">{d.title}</h1>
            {d.subtitle && <p class="t-body text-muted">{d.subtitle}</p>}
          </div>

          {d.intro && <p class="t-body">{d.intro}</p>}

          <div class="project-meta">
            {meta.map((m) => (
              <div class="project-meta__item">
                <p class="t-label">{m.label}</p>
                <p class="t-body">{m.value}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <div class="project-content">
        {d.wip ? (
          <>
            <div class="wip-media">
              {d.wipImg && <img src={withBase(d.wipImg)} alt={`${d.title} — en proceso`} class="wip-figure" />}
              {d.musicId && (
                <div class="music-embed">
                  <iframe
                    src={`https://www.youtube-nocookie.com/embed/${d.musicId}?${musicParams}`}
                    title="Música de fondo — reproductor de YouTube"
                    loading="lazy"
                    allow="autoplay; encrypted-media; picture-in-picture"
                    referrerpolicy="strict-origin-when-cross-origin"
                  ></iframe>
                </div>
              )}
            </div>
            <div class="wip-text">
              <p class="t-label text-muted">Proyecto bajo construcción</p>
              <Content />
            </div>
          </>
        ) : d.blocks.length > 0 ? (
          <div class="project-blocks">
            {d.blocks.map((block, i) => (
              <section class="project-block" data-side={block.side ?? (i % 2 === 0 ? 'left' : 'right')}>
                <img
                  class="project-block__img"
                  src={withBase(block.image)}
                  alt={block.alt}
                  width={blockSizes[i]?.width}
                  height={blockSizes[i]?.height}
                  loading="lazy"
                  decoding="async"
                />
                <div class="project-block__text">
                  {block.sections.map((section) => (
                    <div class="project-block__section">
                      {section.title && <h2 class="t-project-title">{section.title}</h2>}
                      {section.paragraphs.map((p) => <p class="t-body">{p}</p>)}
                    </div>
                  ))}
                </div>
              </section>
            ))}
          </div>
        ) : (
          <div class="project-body"><Content /></div>
        )}
      </div>

      <nav class="project-nav" aria-label="Navegación del proyecto">
        <a href={withBase('proyectos')} class="project-nav__back t-label">Proyectos</a>

        <div class="project-nav__links">
          {prev && <a href={withBase(`proyectos/${prev.id}`)} class="arrow-link">{prev.data.title}</a>}
          {next && <a href={withBase(`proyectos/${next.id}`)} class="arrow-link">{next.data.title}</a>}
        </div>
      </nav>

    </div>
  </div>
</Layout>
