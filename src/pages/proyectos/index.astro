---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Proyectos — Rafael Hijano" description="Proyectos de diseño visual: branding, editorial, UX/UI y motion graphics.">
  <div class="page">
    <div class="container">
      <h1 class="t-hero page-title">Proyectos</h1>
      <div class="projects__grid">
        {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </div>
  </div>
</Layout>
