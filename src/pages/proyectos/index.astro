---
import Layout from '../../layouts/Layout.astro';
import ProjectBrowser from '../../components/ProjectBrowser.astro';
import { getProjects } from '../../data/projects';

const projects = await getProjects();
---

<Layout title="Proyectos de branding, diseño editorial y motion graphics" description="Proyectos de branding e identidad visual, diseño editorial, packaging, UX/UI y motion graphics de Rafael Hijano, diseñador gráfico en Málaga.">
  <div class="page">
    <div class="container">
      <header class="projects-header stack">
        <h1 class="t-hero">Proyectos</h1>
        <p class="t-body measure">
          Una selección de mis trabajos de branding e identidad visual, diseño editorial, motion graphics y UX/UI.
          Cada proyecto cuenta el proceso detrás del resultado: filtra por área para ver los que más te interesen.
        </p>
      </header>

      <ProjectBrowser projects={projects} mode="dim" numbered />
    </div>
  </div>
</Layout>
