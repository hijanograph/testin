---
import Layout from '../../layouts/Layout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { getProjects } from '../../data/projects';

const projects = await getProjects();
---

<Layout title="Proyectos" description="Proyectos de diseño visual: branding, editorial, UX/UI y motion graphics.">
  <div class="page">
    <div class="container">
      <header class="projects__intro stack">
        <h1 class="t-hero">Proyectos</h1>
        <p class="t-body measure">
          Una selección de mis trabajos de branding, editorial, motion graphics y más. Cada proyecto cuenta
          el proceso detrás del resultado: filtra por área para ver los que más te interesen.
        </p>
      </header>

      <ProjectGrid projects={projects} mode="dim" numbered />
    </div>
  </div>
</Layout>
