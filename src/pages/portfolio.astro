---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Portfolio — Rafael Hijano"
  description="Portfolio en PDF de Rafael Hijano, Diseñador Visual."
>
  <main class="page">
    <div class="container">

      <header class="cv-header">
        <h1 class="t-hero">Portfolio</h1>
      </header>

      <div class="pdf-viewer">
        <iframe
          src="https://drive.google.com/file/d/1p5WQXuLPW-kFGgMLAzbrCEaSUpG7zqYD/preview"
          title="Portfolio de Rafael Hijano"
          allow="autoplay"
        ></iframe>
      </div>

      <div class="cv-cta">
        <a
          href="https://drive.google.com/uc?export=download&id=1p5WQXuLPW-kFGgMLAzbrCEaSUpG7zqYD"
          target="_blank"
          rel="noopener noreferrer"
          class="download-btn t-label"
        >
          Descargar PDF ↓
        </a>
      </div>

    </div>
  </main>
</Layout>

<style>
.page {
  padding-top: calc(var(--nav-h) + 3rem);
  padding-bottom: 3rem;
}

.cv-header {
  margin-bottom: 2rem;
}

.cv-cta {
  display: flex;
  justify-content: center;
  margin-top: 1.5rem;
}

.download-btn {
  border: 1px solid var(--ink);
  padding: 0.65em 1.4em;
  transition: background 0.2s, color 0.2s;
  white-space: nowrap;
}

.download-btn:hover {
  background: var(--ink);
  color: var(--cream);
}

.pdf-viewer {
  width: 100%;
  height: 90vh;
  margin-inline: auto;
  overflow: hidden;
  border: 1px solid var(--ink-10);
  background: var(--cream);
}

.pdf-viewer iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
}

@media (max-width: 800px) {
  .page {
    padding-top: calc(var(--nav-h) + 2rem);
  }

  .pdf-viewer {
    height: 75vh;
  }
}
</style>