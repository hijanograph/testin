---
import Layout from '../layouts/Layout.astro';
import LinkList from '../components/LinkList.astro';
import { email, socials, downloads, withBase } from '../site';

const contactImage = 'images/contact/Contact-img.avif';
const channels = [
  { label: 'Redes', links: socials, id: undefined },
  { label: 'Descargas', links: downloads, id: 'descargas' },
];
---

<Layout
  title="Contacto: diseñador gráfico y visual en Málaga"
  description="Contacta con Rafael Hijano, diseñador gráfico y visual en Málaga y en remoto, para colaborar en proyectos de branding, identidad visual y diseño editorial."
  image={contactImage}
>
  <div class="page">
    <div class="container">
      <div class="contact">
        <header>
          <h1 class="t-hero">Contacto</h1>
        </header>

        <img src={withBase(contactImage)} alt="Rafael Hijano, diseñador gráfico y visual en Málaga" class="contact__img" decoding="async" />

        <section>
          <p class="t-body">
            ¿Tienes un proyecto en mente, una oferta o simplemente quieres saludar?
            Escríbeme: siempre tengo ganas de hablar de diseño, de branding y de nuevas oportunidades de colaboración.
          </p>
        </section>

        <section class="contact__item">
          <span class="t-label contact__label">Correo electrónico</span>
          <a href={`mailto:${email}`} class="big-email">{email}</a>
        </section>

        <section class="contact__methods">
          {channels.map(({ label, links, id }) => (
            <div class="contact__item" id={id}>
              <span class="t-label contact__label">{label}</span>
              <LinkList links={links} />
            </div>
          ))}
        </section>
      </div>
    </div>
  </div>
</Layout>
