---
import Layout from '../layouts/Layout.astro';
import { email, socials, downloads, withBase } from '../site';
---

<Layout
  title="Contacto"
  description="Ponte en contacto con Rafael Hijano, Diseñador Visual."
  image="images/contact/Contact-img.png"
>
  <div class="page">
    <div class="container">
      <div class="contact">
        <header>
          <h1 class="t-hero">Contacto</h1>
        </header>

        <img src={withBase('images/contact/Contact-img.png')} alt="Rafael Hijano" class="contact-img" decoding="async" />

        <section>
          <p class="t-body">
            ¿Tienes algún proyecto en mente, una propuesta o simplemente quieres saludar?
            Escríbeme: siempre tengo ganas de hablar sobre diseño visual, nuevas ideas y oportunidades de colaboración.
          </p>
        </section>

        <section class="contact-item">
          <span class="t-label contact-label">Correo electrónico</span>
          <a href={`mailto:${email}`} class="big-email">{email}</a>
        </section>

        <section class="contact-methods">
          <div class="contact-item">
            <span class="t-label contact-label">Redes</span>
            <ul class="link-list">
              {socials.map((s) => (
                <li><a href={s.href} target="_blank" rel="noopener noreferrer" class="cta">{s.label}</a></li>
              ))}
            </ul>
          </div>

          <div class="contact-item" id="descargas">
            <span class="t-label contact-label">Descargas</span>
            <ul class="link-list">
              {downloads.map((d) => (
                <li><a href={d.href} target="_blank" rel="noopener noreferrer" class="cta">{d.label}</a></li>
              ))}
            </ul>
          </div>
        </section>
      </div>
    </div>
  </div>
</Layout>
