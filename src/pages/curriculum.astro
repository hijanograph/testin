---
import Layout from '../layouts/Layout.astro';
import { skills, experience, education, cvDownloadUrl, cvPreviewUrl } from '../data/cv';
---

<Layout title="Currículum — Rafael Hijano" description="Currículum y trayectoria profesional de Rafael Hijano, Diseñador Visual.">
  <div class="page">
    <div class="container">

      <section class="intro">
        <h1 class="t-hero intro__title">Currículum</h1>

        <div class="intro__grid">
          <div class="intro__photo-wrap">
            <div class="img-ph intro__photo"></div>
          </div>
        </div>
      </section>

      <hr />

      <div class="cv-cta">
        <a href={cvDownloadUrl} target="_blank" rel="noopener noreferrer" class="download-btn t-label">
          Descargar CV ↓
        </a>
      </div>

      <section class="section">
        <h2 class="cv-section-label t-label">Experiencia</h2>

        {experience.map((item) => (
          <div class="cv-entry">
            <div class="cv-entry__head">
              <div><strong>{item.role}</strong><span class="cv-company">{item.company}</span></div>
              <span class="t-label">{item.period}</span>
            </div>
            <p class="t-body cv-entry__desc">{item.companyDesc}</p>
            <ul class="cv-tasks">
              {item.tasks.map((t) => <li class="t-body">{t}</li>)}
            </ul>
          </div>
        ))}

        <div class="cv-cta">
          <a href={cvDownloadUrl} target="_blank" rel="noopener noreferrer" class="download-btn t-label">
            Descargar CV ↓
          </a>
        </div>
      </section>

      <hr />

      <section class="section">
        <h2 class="cv-section-label t-label">Educación</h2>

        {education.map((e) => (
          <div class="cv-entry">
            <div class="cv-entry__head">
              <div><strong>{e.title}</strong><span class="cv-company">{e.institution}</span></div>
              <span class="t-label">{e.period}</span>
            </div>
          </div>
        ))}

        <div class="cv-cta">
          <a href={cvDownloadUrl} target="_blank" rel="noopener noreferrer" class="download-btn t-label">
            Descargar CV ↓
          </a>
        </div>
      </section>

      <hr />

      <section class="section">
        <h2 class="t-section section__title">Habilidades</h2>
        <div class="skills">
          {skills.map((s) => <span class="skill t-label">{s}</span>)}
        </div>

        <div class="cv-cta">
          <a href={cvDownloadUrl} target="_blank" rel="noopener noreferrer" class="download-btn t-label">
            Descargar CV ↓
          </a>
        </div>
      </section>

      <hr />

      <section class="section">
        <div class="pdf-viewer">
          <iframe
            src={cvPreviewUrl}
            title="Currículum de Rafael Hijano"
          ></iframe>
        </div>

        <div class="cv-cta">
          <a
            href={cvDownloadUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="download-btn t-label"
          >
            Descargar PDF de Drive ↓
          </a>
        </div>
      </section>

    </div>
  </div>
</Layout>