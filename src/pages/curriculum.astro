---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const siteEntry = await getEntry('sobremi', 'site');
const site = siteEntry?.data;

const experience     = site?.experience     ?? [];
const education      = site?.education      ?? [];
const skillsSoftware = site?.skillsSoftware ?? [];
const skillsAreas    = site?.skillsAreas    ?? [];
const cvIntro        = site?.cvIntro        ?? '';
const cvPdfPath      = site?.cvPdfPath      ?? '/cv-rafael-hijano.pdf';
---

<Layout
  title="Currículum — Rafael Hijano"
  description="Experiencia, educación y habilidades de Rafael Hijano, Diseñador Visual."
>
  <div class="page">
    <div class="container">

      <div class="cv-header">
        <h1 class="t-hero">Currículum</h1>
        <a href={cvPdfPath} download class="download-btn t-label">
          Descargar PDF ↓
        </a>
      </div>

      <p class="t-body cv-intro">{cvIntro}</p>

      <hr />

      <!-- Experiencia -->
      <section class="section">
        <h2 class="cv-section-label t-label">Experiencia</h2>
        {experience.map((item) => (
          <div class="cv-entry">
            <div class="cv-entry__head">
              <div>
                <strong>{item.role}</strong>
                <span class="cv-company">{item.company}</span>
              </div>
              <span class="t-label">{item.period}</span>
            </div>
            <ul class="cv-tasks">
              {item.tasks.map((t) => <li class="t-body">{t}</li>)}
            </ul>
          </div>
        ))}
      </section>

      <hr />

      <!-- Educación -->
      <section class="section">
        <h2 class="cv-section-label t-label">Educación</h2>
        {education.map((e) => (
          <div class="cv-entry">
            <div class="cv-entry__head">
              <div>
                <strong>{e.title}</strong>
                <span class="cv-company">{e.institution}</span>
              </div>
              <span class="t-label">{e.period}</span>
            </div>
          </div>
        ))}
      </section>

      <hr />

      <!-- Habilidades -->
      <section class="section">
        <h2 class="cv-section-label t-label">Habilidades</h2>
        <div class="skills-cols">
          <div>
            <p class="t-label skills-sub">Software</p>
            <ul class="plain-list">
              {skillsSoftware.map((s) => <li class="t-body">{s}</li>)}
            </ul>
          </div>
          <div>
            <p class="t-label skills-sub">Áreas</p>
            <ul class="plain-list">
              {skillsAreas.map((s) => <li class="t-body">{s}</li>)}
            </ul>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
.page { padding-top: calc(var(--nav-h) + 3rem); padding-bottom: 2rem; }

.cv-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.download-btn {
  border: 1px solid var(--ink);
  padding: 0.65em 1.4em;
  transition: background 0.2s, color 0.2s;
  white-space: nowrap;
}
.download-btn:hover { background: var(--ink); color: var(--cream); }

.cv-intro { max-width: 60ch; margin-bottom: 3rem; }
hr { margin: 0; }
.section { padding: 2.5rem 0; }

.cv-section-label { margin-bottom: 1.5rem; display: block; }

.cv-entry { padding: 1.25rem 0; border-bottom: 1px solid var(--ink-10); }
.cv-entry:last-child { border-bottom: none; }

.cv-entry__head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}
.cv-entry__head > div { display: flex; flex-direction: column; gap: 0.15rem; }
.cv-entry__head strong { font-size: 0.95rem; font-weight: 600; }
.cv-company { font-size: 0.75rem; color: var(--ink-60); font-weight: 400; }

.cv-tasks { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
.cv-tasks li { padding-left: 1.2rem; position: relative; max-width: 68ch; }
.cv-tasks li::before { content: '—'; position: absolute; left: 0; color: var(--ink-30); }

.skills-cols { display: grid; gap: 2rem; }
@media (min-width: 600px) { .skills-cols { grid-template-columns: 1fr 1fr; } }

.skills-sub { margin-bottom: 0.75rem; display: block; }

.plain-list { list-style: none; display: flex; flex-direction: column; gap: 0.4rem; }
.plain-list li { padding-left: 1rem; position: relative; }
.plain-list li::before { content: '·'; position: absolute; left: 0; color: var(--ink-30); }
</style>
