---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Currículum — Rafael Hijano" description="Experiencia, educación y habilidades de Rafael Hijano, Diseñador Visual.">
  <div class="page">
    <div class="container">

      <div class="cv-header">
        <h1 class="t-hero">Currículum</h1>
        <a href="/cv-rafael-hijano.pdf" download class="download-btn t-label">
          Descargar PDF ↓
        </a>
      </div>

      <p class="t-body cv-intro">
        Diseñador Visual con base en Málaga. Experiencia en branding, editorial,
        UX/UI y motion graphics. Graduado en Comunicación Audiovisual (UMA) y
        Máster en Diseño Visual (La Gauss).
      </p>

      <hr />

      <!-- Experiencia -->
      <section class="section">
        <h2 class="cv-section-label t-label">Experiencia</h2>

        <div class="cv-entry">
          <div class="cv-entry__head">
            <div><strong>Diseñador Visual</strong><span class="cv-company">Batterylight</span></div>
            <span class="t-label">Feb 2025 — presente</span>
          </div>
          <ul class="cv-tasks">
            <li class="t-body">Gestión del departamento de marketing, diseño de packaging y edición de catálogos.</li>
            <li class="t-body">Optimización de materiales de venta en formatos editables, garantizando coherencia visual y cumplimiento de guías de marca.</li>
          </ul>
        </div>

        <div class="cv-entry">
          <div class="cv-entry__head">
            <div><strong>Diseñador de Marca</strong><span class="cv-company">Freepik</span></div>
            <span class="t-label">Feb 2024</span>
          </div>
          <ul class="cv-tasks">
            <li class="t-body">Proyecto Neighborhood Design: identidad de marca para negocio urbano, rebranding y coordinación con producción e impresión.</li>
            <li class="t-body">Creación de recursos de marca y materiales de marketing para mejorar visibilidad y engagement.</li>
          </ul>
        </div>

        <div class="cv-entry">
          <div class="cv-entry__head">
            <div><strong>Marketing Specialist</strong><span class="cv-company">Ertheo</span></div>
            <span class="t-label">Feb 2019 — Abr 2020</span>
          </div>
          <ul class="cv-tasks">
            <li class="t-body">Gestión de campañas de marketing digital en múltiples mercados europeos.</li>
            <li class="t-body">Creación de materiales de comunicación y coordinación con el equipo de diseño.</li>
          </ul>
        </div>
      </section>

      <hr />

      <!-- Educación -->
      <section class="section">
        <h2 class="cv-section-label t-label">Educación</h2>

        <div class="cv-entry">
          <div class="cv-entry__head">
            <div><strong>Máster en Diseño Visual</strong><span class="cv-company">La X Gauss</span></div>
            <span class="t-label">2021 — 2023</span>
          </div>
        </div>
        <div class="cv-entry">
          <div class="cv-entry__head">
            <div><strong>Máster en Dirección y Liderazgo</strong><span class="cv-company">GADE Business School</span></div>
            <span class="t-label">2020</span>
          </div>
        </div>
        <div class="cv-entry">
          <div class="cv-entry__head">
            <div><strong>Grado en Comunicación Audiovisual</strong><span class="cv-company">Universidad de Málaga</span></div>
            <span class="t-label">2015 — 2019</span>
          </div>
        </div>
      </section>

      <hr />

      <!-- Habilidades -->
      <section class="section">
        <h2 class="cv-section-label t-label">Habilidades</h2>
        <div class="skills-cols">
          <div>
            <p class="t-label skills-sub">Software</p>
            <ul class="plain-list">
              <li class="t-body">Adobe Illustrator</li>
              <li class="t-body">Adobe InDesign</li>
              <li class="t-body">Adobe Photoshop</li>
              <li class="t-body">Adobe After Effects</li>
              <li class="t-body">Adobe Premiere Pro</li>
              <li class="t-body">Figma</li>
              <li class="t-body">WordPress</li>
              <li class="t-body">HTML5</li>
            </ul>
          </div>
          <div>
            <p class="t-label skills-sub">Áreas</p>
            <ul class="plain-list">
              <li class="t-body">Branding &amp; Identidad Visual</li>
              <li class="t-body">Diseño Editorial</li>
              <li class="t-body">UX/UI Design</li>
              <li class="t-body">Motion Graphics</li>
              <li class="t-body">Packaging</li>
              <li class="t-body">Dirección Creativa</li>
            </ul>
          </div>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
.page {
  padding-top: calc(var(--nav-h) + 3rem);
  padding-bottom: 2rem;
}

.cv-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1.5rem;
  margin-bottom: 1.5rem;
}

.download-btn {
  border: 1px solid var(--ink);
  padding: 0.65em 1.4em;
  transition: background 0.2s, color 0.2s;
  white-space: nowrap;
}
.download-btn:hover {
  background: var(--ink);
  color: var(--cream);
}

.cv-intro {
  max-width: 60ch;
  margin-bottom: 3rem;
}

hr { margin: 0; }

.section { padding: 2.5rem 0; }

.cv-section-label {
  margin-bottom: 1.5rem;
  display: block;
}

/* Entries */
.cv-entry {
  padding: 1.25rem 0;
  border-bottom: 1px solid var(--ink-10);
}
.cv-entry:last-child { border-bottom: none; }

.cv-entry__head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 0.75rem;
}

.cv-entry__head > div {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.cv-entry__head strong {
  font-size: 0.95rem;
  font-weight: 600;
}

.cv-company {
  font-size: 0.75rem;
  color: var(--ink-60);
  font-weight: 400;
}

.cv-tasks {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.cv-tasks li {
  padding-left: 1.2rem;
  position: relative;
  max-width: 68ch;
}
.cv-tasks li::before {
  content: '—';
  position: absolute;
  left: 0;
  color: var(--ink-30);
}

/* Skills */
.skills-cols {
  display: grid;
  gap: 2rem;
}
@media (min-width: 600px) {
  .skills-cols { grid-template-columns: 1fr 1fr; }
}

.skills-sub { margin-bottom: 0.75rem; display: block; }

.plain-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.plain-list li {
  padding-left: 1rem;
  position: relative;
}
.plain-list li::before {
  content: '·';
  position: absolute;
  left: 0;
  color: var(--ink-30);
}
</style>
