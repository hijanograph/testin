---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Currículum — Rafael Hijano" description="Currículum en PDF de Rafael Hijano, Diseñador Visual.">
  <div class="page">
    <div class="container">

      <div class="cv-header">
        <h1 class="t-hero">Currículum</h1>
      </div>

      <div class="pdf-viewer">
        <iframe
          src="https://drive.google.com/file/d/16K_kHrIxXQuXzdytIGrX46_dsheItNwA/preview"
          title="Currículum de Rafael Hijano"
          loading="lazy"
          allow="autoplay"
        ></iframe>
      </div>

      <div class="cv-cta">
        <a
          href="https://drive.google.com/uc?export=download&id=16K_kHrIxXQuXzdytIGrX46_dsheItNwA"
          target="_blank"
          rel="noopener noreferrer"
          class="download-btn t-label"
        >
          Descargar PDF ↓
        </a>
      </div>

    </div>
  </div>
</Layout>

<style>
.page {
  padding-top: calc(var(--nav-h) + 3rem);
  padding-bottom: 3rem;
}

.cv-header {
  margin-bottom: 2rem;
}

.cv-cta {
  display: flex;
  justify-content: center;
  margin-top: 1.5rem;
}

.download-btn {
  border: 1px solid var(--ink);
  padding: 0.65em 1.4em;
  transition: background 0.2s, color 0.2s;
  white-space: nowrap;
}
.download-btn:hover {
  background: var(--ink);
  color: var(--cream);
}

.pdf-viewer {
  width: 100%;
  margin-inline: auto;
  height: 90vh;
  overflow: hidden;
  border: 1px solid var(--ink-10);
  background: var(--cream);
}

.pdf-viewer iframe {
  width: 100%;
  height: 100%;
  border: 0;
}
</style>