---
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ContactSection from '../components/ContactSection.astro';
import PageIntro from '../components/PageIntro.astro';
import ProjectBrowser from '../components/ProjectBrowser.astro';
import SectionHead from '../components/SectionHead.astro';
import SplitRow from '../components/SplitRow.astro';
import { getProjects } from '../data/projects';
import { servicios, proceso, introPorDefecto, introPorArea } from '../data/servicios';
import { pad2 } from '../utils/format';
import { email, portfolioDownload, professionalSocials, withBase } from '../site';

const projects = await getProjects({ featured: true });
const samples = [portfolioDownload, ...professionalSocials];
---

<Layout
  title="Servicios"
  description="Servicios de diseño visual freelance: identidad de marca, editorial, packaging, motion graphics y UX/UI."
  noindex
>
  <div class="page">
    <div class="container">
      <PageIntro eyebrow="Para empresas y marcas" title={introPorDefecto.title}>
        <p class="t-lead">{introPorDefecto.lead}</p>
        <p class="t-body">{introPorDefecto.body}</p>
        <div class="link-list">
          <Cta href={`mailto:${email}`}>Cuéntame tu proyecto</Cta>
          <Cta href={portfolioDownload.href} external>Ver portfolio en PDF</Cta>
        </div>
      </PageIntro>

      <HeroCarousel projects={projects} />

      <section class="section section--grid" id="servicios">
        <SectionHead title="Qué puedo hacer por ti" />

        {servicios.map(({ title, detail, items, areas }) => (
          <SplitRow data-areas={areas.join(' ')}>
            <h3 slot="head" class="t-title">{title}</h3>
            <p class="t-body">{detail}</p>
            <ul class="line-list">
              {items.map((item) => <li>{item}</li>)}
            </ul>
          </SplitRow>
        ))}
      </section>

      <section class="section section--grid" id="proceso">
        <SectionHead title="Cómo trabajo" />

        {proceso.map(({ title, text }, i) => (
          <SplitRow>
            <Fragment slot="head">
              <span class="t-label t-muted">{pad2(i + 1)}</span>
              <h3 class="t-title">{title}</h3>
            </Fragment>
            <p class="t-body">{text}</p>
          </SplitRow>
        ))}
      </section>

      <section class="section" id="proyectos">
        <SectionHead title="Ejemplos de mi trabajo">
          <Cta href={withBase('proyectos')}>Ver todos</Cta>
        </SectionHead>
        <ProjectBrowser projects={projects} lockOnHash />
      </section>

      <ContactSection title="Hablemos de tu proyecto" links={samples} />
    </div>
  </div>

  <script
    type="application/json"
    id="intro-variants"
    set:html={JSON.stringify({ default: introPorDefecto, ...introPorArea })}
  />
</Layout>

<script>
  import '../scripts/area-intro';
</script>
