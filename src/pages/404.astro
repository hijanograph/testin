---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — Rafael Hijano">
  <div class="page page--error">
    <div class="container stack">
      <p class="t-label">Error 404</p>
      <h1 class="t-hero">Página no encontrada</h1>
      <p class="t-body error-text">Esta página no existe o ha sido movida.</p>
      <a href="/" class="arrow-link">Volver al inicio</a>
    </div>
  </div>
</Layout>