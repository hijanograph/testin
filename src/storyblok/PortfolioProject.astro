---
import { renderRichText } from '@storyblok/astro';
import ProjectLayout from '../components/ProjectLayout.astro';
import Layout from '../layouts/Layout.astro';

const { blok } = Astro.props;

const bodyHtml = blok.body ? renderRichText(blok.body) : '';
---

<Layout title={`${blok.title} — Rafael Hijano`} description={blok.desc}>
  <ProjectLayout
    title={blok.title}
    subtitle={blok.subtitle}
    area={blok.area}
    rol={blok.rol}
    software={blok.software}
    heroImg={blok.hero_image?.filename}
    heroAlt={blok.hero_alt}
    prevHref={blok.prev_project ? `/portfolio/${blok.prev_project}` : undefined}
    prevLabel={blok.prev_label}
    nextHref={blok.next_project ? `/portfolio/${blok.next_project}` : undefined}
    nextLabel={blok.next_label}
    wip={blok.wip}
  >
    <div class="project-body" set:html={bodyHtml} />
  </ProjectLayout>
</Layout>
