---
const { blok } = Astro.props;
---
<div class="timeline__item">
  <div class="timeline__head">
    <div>
      <p class="timeline__role">{blok.role}</p>
      <p class="t-label timeline__company">{blok.company}</p>
    </div>
    <span class="t-label timeline__period">{blok.period}</span>
  </div>
  <p class="t-body timeline__desc">{blok.company_desc}</p>
  <ul class="timeline__tasks">
    {blok.tasks?.map((task) => <li class="t-body">{task.text}</li>)}
  </ul>
</div>
