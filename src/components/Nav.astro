---
import { pages, social } from '../site';

const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const home = normalize(pages[0].href);
const current = normalize(Astro.url.pathname);

// "Proyectos" también queda activo en /proyectos/nombre-del-caso
const isActive = (href: string) => {
  const target = normalize(href);
  return target === home ? current === target : current === target || current.startsWith(`${target}/`);
};

const externalLinks = [
  { label: 'LinkedIn', href: social.linkedin },
  { label: 'Behance', href: social.behance },
];
---

<div class="navigation" transition:persist>

  <header class="nav" id="nav">
    <div class="nav__inner">
      <a href={pages[0].href} class="nav__logo t-nav">RAFAEL HIJANO</a>

      <nav class="nav__desktop" aria-label="Navegación principal">
        <ul class="nav__list">
          {
            pages.map(({ label, href }) => {
              const active = isActive(href);

              return (
                <li>
                  <a
                    href={href}
                    class:list={['nav__link', 't-nav', { 'nav__link--active': active }]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <button
        class="nav__toggle"
        id="navToggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="navOverlay"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </header>

  <div class="nav-overlay" id="navOverlay" aria-hidden="true" inert>
    <div class="nav-overlay__inner">
      <nav class="nav-overlay__nav" aria-label="Navegación móvil">
        <ul class="nav-overlay__list">
          {
            pages.map(({ label, href }) => {
              const active = isActive(href);

              return (
                <li>
                  <a
                    href={href}
                    class:list={['nav__link', 't-nav', 'nav-overlay__link', { 'nav__link--active': active }]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              );
            })
          }

          {
            externalLinks.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="nav__link t-nav nav-overlay__link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

</div>

<script>
  const normalize = (path: string) => path.replace(/\/$/, '') || '/';

  const init = () => {
    const toggle = document.getElementById('navToggle');
    const overlay = document.getElementById('navOverlay');
    const nav = document.getElementById('nav');
    if (!toggle || !overlay || !nav) return;

    // El nav persiste entre páginas (transition:persist): hay que refrescar el enlace activo.
    const home = normalize(new URL(document.querySelector<HTMLAnchorElement>('.nav__logo')!.href).pathname);
    const current = normalize(location.pathname);
    document.querySelectorAll<HTMLAnchorElement>('.nav__link[href]').forEach((link) => {
      if (link.origin !== location.origin) return;
      const path = normalize(link.pathname);
      const active = path === home ? current === path : current === path || current.startsWith(`${path}/`);
      link.classList.toggle('nav__link--active', active);
      active ? link.setAttribute('aria-current', 'page') : link.removeAttribute('aria-current');
    });

    if (document.activeElement === toggle) toggle.blur();
    if (toggle.dataset.initialized) return;
    toggle.dataset.initialized = 'true';

    const setOpen = (open: boolean) => {
      overlay.classList.toggle('open', open);
      overlay.setAttribute('aria-hidden', String(!open));
      overlay.inert = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      document.body.classList.toggle('menu-open', open);
      if (open) overlay.querySelector('a')?.focus();
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    // Cualquier clic dentro del overlay lo cierra; los enlaces internos los navega el ClientRouter.
    overlay.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
    matchMedia('(min-width: 1072px)').addEventListener('change', (e) => e.matches && setOpen(false));

    const onScroll = () => nav.classList.toggle('scrolled', scrollY > 4);
    addEventListener('scroll', onScroll, { passive: true }); // el navegador ya agrupa por frame
    onScroll();
    setOpen(false);
  };

  document.addEventListener('astro:page-load', init);
</script>
