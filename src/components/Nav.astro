---
import NavLink from './NavLink.astro';
import NavOverlay from './NavOverlay.astro';
import { pages, professionalSocials } from '../site';
import { isActivePath } from '../utils/path';

const [home] = pages;
const items = pages.map((page) => ({ ...page, active: isActivePath(Astro.url.pathname, page.href, home.href) }));
---

<div class="site-nav" transition:persist>
  <header class="nav">
    <div class="nav__inner">
      <a href={home.href} class="nav__logo t-nav">RAFAEL HIJANO</a>

      <nav class="nav__desktop" aria-label="Navegación principal">
        <ul class="nav__list">
          {items.map((item) => <NavLink {...item} variant="desktop" />)}
        </ul>
      </nav>

      <button
        class="nav__toggle"
        id="navToggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="navOverlay"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </header>

  <NavOverlay items={items} externalLinks={professionalSocials} />
</div>

<script>
  import { initNav } from '../scripts/nav';

  document.addEventListener('astro:page-load', initNav);
</script>
