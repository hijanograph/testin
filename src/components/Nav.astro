---
const path = Astro.url.pathname;
const links = [
  { label: 'Inicio', href: '/' },
  { label: 'Sobre mí', href: '/sobre-mi' },
  { label: 'Currículum', href: '/curriculum' },
  { label: 'Portfolio', href: '/portfolio' },
];
---

<header class="nav" id="nav">
  <div class="nav__inner">
    <div class="nav__box">
      <a href="/" class="nav__logo">RAFAEL HIJANO</a>
    </div>

    <div class="nav__box nav__box--empty"></div>

    <nav class="nav__links">
      <div class="nav__box">
        <a
          href="/"
          class:list={[
            'nav__link t-nav',
            { 'nav__link--active': path === '/' }
          ]}
        >
          Inicio
        </a>
      </div>

      <div class="nav__box">
        <a
          href="/sobre-mi"
          class:list={[
            'nav__link t-nav',
            { 'nav__link--active': path === '/sobre-mi' }
          ]}
        >
          Sobre mí
        </a>
      </div>

      <div class="nav__box">
        <a
          href="/curriculum"
          class:list={[
            'nav__link t-nav',
            { 'nav__link--active': path === '/curriculum' }
          ]}
        >
          Currículum
        </a>
      </div>

      <div class="nav__box">
        <a
          href="/portfolio"
          class:list={[
            'nav__link t-nav',
            { 'nav__link--active': path === '/portfolio' }
          ]}
        >
          Portfolio
        </a>
      </div>
    </nav>

    <!-- ÚNICO BOTÓN: hamburguesa / X -->
    <button
      class="nav__toggle"
      id="navToggle"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<div class="nav-overlay" id="navOverlay" aria-hidden="true">
  <nav class="nav-overlay__links">
    {[
      ...links,
      {
        label: 'LinkedIn',
        href: 'https://linkedin.com/in/rafaelhijano',
        ext: true
      },
      {
        label: 'Behance',
        href: 'https://behance.net/rafaelhijano',
        ext: true
      },
    ].map(l => (
      <a
        href={l.href}
        class="nav__link t-nav nav-overlay__link"
        target={l.ext ? '_blank' : undefined}
        rel={l.ext ? 'noopener noreferrer' : undefined}
      >
        {l.label} <span>↘</span>
      </a>
    ))}
  </nav>
</div>

<style>
.nav {
  position: fixed;
  inset: 0 0 auto 0;
  z-index: 100;
  height: var(--nav-h);
  width: 100%;
  border-bottom: 1px solid transparent;
  transition: border-color 0.3s;
}

.nav.scrolled {
  border-color: var(--ink-10);
}

.nav__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 100%;
  padding: 28px 47px;
  box-sizing: border-box;
  position: relative;
}

.nav__logo {
  font-size: 1.33rem;
  font-weight: 500;
  letter-spacing: -0.03em;
  text-transform: uppercase;
  flex-shrink: 0;
  font-variant-ligatures: common-ligatures;
  font-kerning: normal;
  font-feature-settings: "kern" 1, "ss05" 1, "ss06" 1, "ss07" 1;
  hanging-punctuation: first last;
  text-decoration: none;
}

.nav__box {
  display: none;
}

.nav__inner > .nav__box:nth-child(1) {
  display: flex;
  flex: 1;
  justify-content: flex-start;
}

.nav__links {
  display: none;
}

/* =========================
   BOTÓN HAMBURGUESA / X
   ========================= */

.nav__toggle {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;

  width: auto;
  background: none;
  border: none;
  padding: 6px;
  margin-left: auto;

  cursor: pointer;
  position: relative;
}

.nav__toggle span {
  display: block;
  width: 24px;
  height: 2.4px;
  background: var(--ink);

  transform-origin: center;
  transition:
    transform 0.3s ease,
    opacity 0.2s ease;
}

/* =========================
   ESTADO ABIERTO → X
   ========================= */

.nav__toggle[aria-expanded="true"] span:nth-child(1) {
  transform: translateY(6.4px) rotate(45deg);
}

.nav__toggle[aria-expanded="true"] span:nth-child(2) {
  opacity: 0;
}

.nav__toggle[aria-expanded="true"] span:nth-child(3) {
  transform: translateY(-6.4px) rotate(-45deg);
}

/* =========================
   DESKTOP
   ========================= */

@media (min-width: 980px) {
  .nav__links {
    display: flex;
    flex: 4;
    align-items: center;
    justify-content: space-between;
  }

  .nav__box {
    display: flex;
    flex: 1;
    justify-content: flex-end;
  }

  .nav__box--empty {
    flex: 1;
  }

  .nav__toggle {
    display: none;
  }
}

.nav__link {
  color: var(--ink-60);
  transition: color 0.15s;
  text-align: right;
}

.nav__item {
  display: flex;
  align-items: center;
  gap: 24px;
}

.nav__link:hover,
.nav__link--active {
  color: var(--ink);
  text-decoration: none;
}

/* =========================
   OVERLAY DEL MENÚ MOBILE
   ========================= */

.nav-overlay {
  position: fixed;
  inset: 0;
  z-index: 99;

  background: color-mix(in srgb, var(--cream) 75%, transparent);

  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);

  display: flex;
  flex-direction: column;

  padding: var(--nav-h) 47px 3rem;
  box-sizing: border-box;

  opacity: 0;
  visibility: hidden;

  transition:
    opacity 0.35s ease,
    visibility 0.35s ease;
}

.nav-overlay.open {
  opacity: 1;
  visibility: visible;
}

.nav-overlay__links {
  display: flex;
  flex-direction: column;
  align-items: flex-end;

  margin-top: auto;

  gap: 36px;
  padding-bottom: 0;
}

.nav-overlay__link {
  text-align: right;
  color: var(--ink);
  font-size: 1.67rem;
}

.nav-overlay__link span {
  opacity: 1;
}

.nav-overlay__link:hover {
  opacity: 1;
}
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const overlay = document.getElementById('navOverlay');
  const nav = document.getElementById('nav');

  const openMenu = () => {
    overlay?.classList.add('open');
    overlay?.setAttribute('aria-hidden', 'false');

    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Cerrar menú');

    document.body.style.overflow = 'hidden';
  };

  const closeMenu = () => {
    overlay?.classList.remove('open');
    overlay?.setAttribute('aria-hidden', 'true');

    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Abrir menú');

    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';

    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  // Cerrar al tocar cualquier zona del overlay
  // que no sea un enlace
  overlay?.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;

    if (!event.target.closest('a')) {
      closeMenu();
    }
  });

  // Cerrar al tocar un enlace
  overlay?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', closeMenu);
  });

  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 4);
  });
</script>