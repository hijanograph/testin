---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navigation = [
  { label: 'Inicio', href: '/' },
  { label: 'Sobre mí', href: '/sobre-mi' },
  { label: 'Descargas', href: '/descargas' },
  { label: 'Contacto', href: '/contacto' },
];

const externalLinks = [
  { label: 'LinkedIn', href: 'https://linkedin.com/in/rafaelhijano' },
  { label: 'Behance', href: 'https://behance.net/rafaelhijano' },
];

const isActiveHref = (href: string) =>
  currentPath === (href.replace(/\/$/, '') || '/');
---

<div class="navigation" transition:persist>

  <header class="nav" id="nav">
    <div class="nav__inner">
      <a href="/" class="nav__logo t-nav">RAFAEL HIJANO</a>

      <nav class="nav__desktop" aria-label="Navegación principal">
        <ul class="nav__list">
          {
            navigation.map(({ label, href }) => {
              const isActive = isActiveHref(href);

              return (
                <li>
                  <a
                    href={href}
                    class:list={['nav__link', 't-nav', { 'nav__link--active': isActive }]}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <button
        class="nav__toggle"
        id="navToggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="navOverlay"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </header>

  <div class="nav-overlay" id="navOverlay" aria-hidden="true" inert>
    <div class="nav-overlay__inner">
      <nav class="nav-overlay__nav" aria-label="Navegación móvil">
        <ul class="nav-overlay__list">
          {
            navigation.map(({ label, href }) => {
              const isActive = isActiveHref(href);

              return (
                <li>
                  <a
                    href={href}
                    class:list={['nav__link', 't-nav', 'nav-overlay__link', { 'nav__link--active': isActive }]}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {label}
                    <span aria-hidden="true">↘</span>
                  </a>
                </li>
              );
            })
          }

          {
            externalLinks.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="nav__link t-nav nav-overlay__link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {label}
                  <span aria-hidden="true">↘</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

</div>

<script>
  import { navigate } from 'astro:transitions/client';

  const goTo = (href: string) => {
    try {
      navigate(href);
    } catch {
      window.location.assign(href);
    }
  };

  const initNavigation = () => {
    const toggle = document.getElementById('navToggle');
    const overlay = document.getElementById('navOverlay');
    const nav = document.getElementById('nav');

    if (!toggle || !overlay || !nav) return;
    if (toggle.dataset.initialized === 'true') return;

    toggle.dataset.initialized = 'true';

    const firstLink = overlay.querySelector('a');

    const setMenuState = (open: boolean) => {
      overlay.classList.toggle('open', open);
      overlay.setAttribute('aria-hidden', String(!open));
      overlay.inert = !open;

      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute(
        'aria-label',
        open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación'
      );

      document.body.classList.toggle('menu-open', open);

      if (open) {
        firstLink?.focus();
      }
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      setMenuState(!isOpen);
    });

    const navigateAfterClose = (href: string) => {
      const duration =
        parseFloat(getComputedStyle(overlay).transitionDuration) * 1000;

      setMenuState(false);

      if (!duration) {
        goTo(href);
        return;
      }

      overlay.addEventListener('transitionend', () => goTo(href), { once: true });
    };

    overlay.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) {
        setMenuState(false);
        return;
      }

      const link = event.target.closest('a');

      const isInternalLink =
        link &&
        link.target !== '_blank' &&
        !event.metaKey &&
        !event.ctrlKey &&
        !event.shiftKey &&
        !event.altKey;

      if (isInternalLink) {
        event.preventDefault();
        navigateAfterClose(link.href);
        return;
      }

      setMenuState(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      if (toggle.getAttribute('aria-expanded') === 'true') {
        setMenuState(false);
      }
    });

    const updateScrolledState = () => {
      nav.classList.toggle('scrolled', window.scrollY > 4);
    };

    let ticking = false;

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;

        ticking = true;

        requestAnimationFrame(() => {
          updateScrolledState();
          ticking = false;
        });
      },
      { passive: true }
    );

    updateScrolledState();

    const desktopMedia = window.matchMedia('(min-width: 860px)');

    desktopMedia.addEventListener('change', (event) => {
      if (event.matches) {
        setMenuState(false);
      }
    });

    setMenuState(false);
  };

  const updateActiveLink = () => {
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';

    document.querySelectorAll('.nav__link[href]').forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;

      const url = new URL(link.href, window.location.origin);

      if (url.origin !== window.location.origin) return;

      const linkPath = url.pathname.replace(/\/$/, '') || '/';
      const isActive = currentPath === linkPath;

      link.classList.toggle('nav__link--active', isActive);

      if (isActive) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  const blurStaleToggle = () => {
    if (
      document.activeElement instanceof HTMLElement &&
      document.activeElement.id === 'navToggle'
    ) {
      document.activeElement.blur();
    }
  };

  const init = () => {
    initNavigation();
    updateActiveLink();
    blurStaleToggle();
  };

  document.addEventListener('astro:page-load', init);
  init();
</script>