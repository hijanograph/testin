---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navigation = [
  { label: 'Inicio', href: '/' },
  { label: 'Sobre mí', href: '/sobre-mi' },
  { label: 'Currículum', href: '/curriculum' },
  { label: 'Portfolio', href: '/portfolio' },
];

const externalLinks = [
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/rafaelhijano',
  },
  {
    label: 'Behance',
    href: 'https://behance.net/rafaelhijano',
  },
];
---

<div class="navigation" transition:persist>

  <header class="nav" id="nav">
    <div class="nav__inner">
      <a href="/" class="nav__logo">RAFAEL HIJANO</a>

      <nav class="nav__desktop" aria-label="Navegación principal">
        <ul class="nav__list">
          {
            navigation.map(({ label, href }) => {
              const isActive =
                currentPath === (href.replace(/\/$/, '') || '/');

              return (
                <li>
                  <a
                    href={href}
                    class:list={[
                      'nav__link',
                      { 'nav__link--active': isActive },
                    ]}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <button
        class="nav__toggle"
        id="navToggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="navOverlay"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </header>

  <div
    class="nav-overlay"
    id="navOverlay"
    aria-hidden="true"
    inert
  >
    <div class="nav-overlay__inner">
      <nav class="nav-overlay__nav" aria-label="Navegación móvil">
        <ul class="nav-overlay__list">
          {
            navigation.map(({ label, href }) => {
              const isActive =
                currentPath === (href.replace(/\/$/, '') || '/');

              return (
                <li>
                  <a
                    href={href}
                    class:list={[
                      'nav__link',
                      'nav-overlay__link',
                      { 'nav__link--active': isActive },
                    ]}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {label}
                    <span aria-hidden="true">↘</span>
                  </a>
                </li>
              );
            })
          }

          {
            externalLinks.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="nav__link t-nav nav-overlay__link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {label}
                  <span aria-hidden="true">↘</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    width: 100%;
    height: var(--nav-h);
    box-sizing: border-box;
    transition: border-color 0.3s ease;
  }

  .nav.scrolled {
    border-color: var(--ink-10);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    padding-inline: var(--pad-x);
    box-sizing: border-box;
  }

  .nav__logo {
    flex-shrink: 0;
    color: var(--ink);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav__desktop {
    display: none;
  }

  .nav__list,
  .nav-overlay__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__desktop .nav__list {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(24px, 4vw, 64px);
  }

  .nav__link {
    display: inline-block;
    color: var(--ink-60);
    font-size: 1.67rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    text-align: right;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.15s ease;
  }

  .nav__link:hover,
  .nav__link:focus-visible,
  .nav__link--active {
    color: var(--ink);
    text-decoration: none;
  }

  .nav__toggle {
    flex: 0 0 36px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    margin: 0;
    padding: 6px;
    box-sizing: border-box;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .nav__toggle span {
    display: block;
    width: 24px;
    height: 3px;
    background: var(--ink);
    transform-origin: center center;
    transition:
      transform 0.3s ease,
      opacity 0.2s ease;
  }

  .nav__toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6.4px) rotate(45deg);
  }

  .nav__toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .nav__toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6.4px) rotate(-45deg);
  }

  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 99;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding-top: var(--nav-h);
    padding-inline: var(--pad-x);
    background: color-mix(
      in srgb,
      var(--cream) 75%,
      transparent
    );
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      visibility 0.35s ease;
  }

  .nav-overlay.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .nav-overlay__inner {
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    padding-bottom: 3rem;
    box-sizing: border-box;
  }

  .nav-overlay__nav {
    width: 100%;
  }

  .nav-overlay__list {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    width: 100%;
    gap: 36px;
  }

  .nav-overlay__link {
    color: var(--ink);
  }

  .nav-overlay__link span {
    margin-left: 0.15em;
  }

  :focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  :global(body.menu-open) {
    overflow: hidden;
  }

  @media (min-width: 800px) {
    .nav__logo {
      font-size: 1.33rem;
    }

    .nav__link {
      font-size: 1.2rem;
      text-decoration: none;
      text-transform: uppercase;
      transition: color 0.15s ease;
    }

    .nav__desktop {
      display: block;
      flex: 1;
    }

    .nav__toggle,
    .nav-overlay {
      display: none;
    }

    .nav__inner {
      gap: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav__link,
    .nav__toggle span,
    .nav-overlay {
      transition: none;
    }
  }
</style>

<script>
  const initNavigation = () => {
    const toggle = document.getElementById('navToggle');
    const overlay = document.getElementById('navOverlay');
    const nav = document.getElementById('nav');

    if (!toggle || !overlay || !nav) return;

    if (toggle.dataset.initialized === 'true') return;

    toggle.dataset.initialized = 'true';

    const firstLink = overlay.querySelector('a');

    const setMenuState = (open) => {
      overlay.classList.toggle('open', open);
      overlay.setAttribute('aria-hidden', String(!open));
      overlay.inert = !open;

      toggle.setAttribute('aria-expanded', String(open));

      toggle.setAttribute(
        'aria-label',
        open
          ? 'Cerrar menú de navegación'
          : 'Abrir menú de navegación'
      );

      document.body.classList.toggle('menu-open', open);

      if (open) {
        firstLink?.focus();
      } else {
        toggle.focus();
      }
    };

    toggle.addEventListener('click', () => {
      const isOpen =
        toggle.getAttribute('aria-expanded') === 'true';

      setMenuState(!isOpen);
    });

    overlay.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;

      const link = event.target.closest('a');

      if (link) {
        setMenuState(false);
        return;
      }

      setMenuState(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;

      const isOpen =
        toggle.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        setMenuState(false);
      }
    });

    const updateScrolledState = () => {
      nav.classList.toggle('scrolled', window.scrollY > 4);
    };

    let ticking = false;

    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;

        ticking = true;

        requestAnimationFrame(() => {
          updateScrolledState();
          ticking = false;
        });
      },
      { passive: true }
    );

    updateScrolledState();

    const desktopMedia = window.matchMedia(
      '(min-width: 800px)'
    );

    desktopMedia.addEventListener('change', (event) => {
      if (event.matches) {
        setMenuState(false);
      }
    });

    setMenuState(false);
  };

  document.addEventListener('astro:page-load', initNavigation);

  initNavigation();
</script>