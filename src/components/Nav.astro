---
const path = Astro.url.pathname;

const links = [
  { label: 'Inicio',      href: '/' },
  { label: 'Sobre mí',    href: '/sobre-mi' },
  { label: 'Currículum',  href: '/curriculum' },
  { label: 'Portfolio',   href: '/portfolio' },
];
---

<header class="nav" id="nav">
  <div class="nav__inner">

    <!-- Caja 1: Logo -->
    <div class="nav__box">
      <a href="/" class="nav__logo">RAFAEL HIJANO</a>
    </div>

    <!-- Caja 2: Vacío (Espaciador flexible) -->
    <div class="nav__box nav__box--empty"></div>

    <nav class="nav__links">
    <!-- Caja 3: Inicio -->
    <div class="nav__box">
      <a href="/" class:list={['nav__link t-nav', { 'nav__link--active': path === '/' }]}>Inicio</a>
    </div>

    <!-- Caja 4: Sobre mí -->
    <div class="nav__box">
      <a href="/sobre-mi" class:list={['nav__link t-nav', { 'nav__link--active': path === '/sobre-mi' }]}>Sobre mí</a>
    </div>

    <!-- Caja 5: Currículum -->
    <div class="nav__box">
      <a href="/curriculum" class:list={['nav__link t-nav', { 'nav__link--active': path === '/curriculum' }]}>Currículum</a>
    </div>

    <!-- Caja 6: Portfolio -->
    <div class="nav__box">
      <a href="/portfolio" class:list={['nav__link t-nav', { 'nav__link--active': path === '/portfolio' }]}>Portfolio</a>
    </div>
    </nav>

    <!-- Hamburger (mobile) -->
    <button class="nav__toggle" id="navToggle" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

  </div>
</header>

<!-- Mobile overlay -->
<div class="nav-overlay" id="navOverlay" aria-hidden="true">
  <div class="nav-overlay__bar">
    <span class="nav__logo">RAFAEL HIJANO</span>
    <button class="nav-overlay__close" id="navClose" aria-label="Cerrar menú">✕</button>
  </div>
  <nav class="nav-overlay__links">
    {[...links,
      { label: 'LinkedIn', href: 'https://linkedin.com/in/rafaelhijano', ext: true },
      { label: 'Behance',  href: 'https://behance.net/rafaelhijano',  ext: true },
    ].map(l => (
      <a
        href={l.href}
        class="nav-overlay__link"
        target={l.ext ? '_blank' : undefined}
        rel={l.ext ? 'noopener noreferrer' : undefined}
      >
        {l.label} <span>↘</span>
      </a>
    ))}
  </nav>
</div>

<style>
/* ── Nav bar ──────────────────────────── */
.nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  height: var(--nav-h);
  width: 100%;
  border-bottom: 1px solid transparent;
  transition: border-color 0.3s;
}
.nav.scrolled { border-color: var(--ink-10); }

.nav__inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 100%;
  padding: 28px 47px;
  box-sizing: border-box;
  position: relative;
}

/* Logo */
.nav__logo {
  font-size: 1.2rem;
  font-weight: 500;
  letter-spacing: -0.03em;
  text-transform: uppercase;
  flex-shrink: 0;
  font-variant-ligatures: common-ligatures;
  font-kerning: normal;
  font-feature-settings: "kern" 1, "ss05" 1, "ss06" 1, "ss07" 1;  hanging-punctuation: first last;
  text-decoration: none;
}

/* Contenedor del logo con su separador izquierdo */
.nav__logo-wrapper {
  display: flex;
  align-items: center;
}

/* Desktop links — centrados absolutamente */
.nav__links {
  display: none;
}

@media (min-width: 860px) {
  .nav__links {
    display: flex;
    align-items: center;
    gap: 24px; /* Gap exacto de la interfaz de Figma */
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
}

.nav__link {
  color: var(--ink-60);
  transition: color 0.15s;
  text-align: right;
}

.nav__item {
  display: flex;
  align-items: center;
  gap: 24px; /* Mantiene la distancia de 24px con el separador */
}

.nav__link:hover,
.nav__link--active { color: var(--ink);
text-decoration: none;}

/* Hamburger */
.nav__toggle {
  display: flex;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  padding: 6px;
  margin-left: auto;
  cursor: pointer;
}
.nav__toggle span {
  display: block;
  width: 22px;
  height: 1.5px;
  background: var(--ink);
}
@media (min-width: 860px) {
  .nav__toggle { display: none; }
}

/* ── Mobile overlay ───────────────────── */
.nav-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: var(--cream);
  display: flex;
  flex-direction: column;
  padding: 0 var(--pad-x) 3rem;
  transform: translateX(100%);
  transition: transform 0.38s cubic-bezier(0.76, 0, 0.24, 1);
}
.nav-overlay.open { transform: translateX(0); }

.nav-overlay__bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: var(--nav-h);
  flex-shrink: 0;
}

.nav-overlay__close {
  background: none;
  border: none;
  font-size: 1rem;
  color: var(--ink);
  padding: 6px;
  cursor: pointer;
}

.nav-overlay__links {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0;
  margin-top: auto;
  padding-bottom: 2rem;
}

.nav-overlay__link {
  font-size: clamp(2rem, 8vw, 3rem);
  font-weight: 500;
  letter-spacing: -0.3em;
  text-transform: uppercase;
  color: var(--ink);
  opacity: 0.4;
  padding: 0.2em 0;
  transition: opacity 0.15s;
  display: flex;
  align-items: center;
  gap: 0.3em;
}
.nav-overlay__link span { font-size: 0.55em; opacity: 0.7; }
.nav-overlay__link:hover { opacity: 1; }
</style>

<script>
  const toggle  = document.getElementById('navToggle');
  const close   = document.getElementById('navClose');
  const overlay = document.getElementById('navOverlay');
  const nav     = document.getElementById('nav');

  const openMenu = () => {
    overlay?.classList.add('open');
    overlay?.setAttribute('aria-hidden', 'false');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  };
  const closeMenu = () => {
    overlay?.classList.remove('open');
    overlay?.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  toggle?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  overlay?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

  window.addEventListener('scroll', () => {
    nav?.classList.toggle('scrolled', window.scrollY > 4);
  });
</script>
