---
import ProjectCard from './ProjectCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'portfolio'>[];
  numbered?: boolean;
}

const { projects, numbered = false } = Astro.props;
---

<div class="project-grid">
  {projects.map((project, i) => <ProjectCard project={project} number={numbered ? i + 1 : undefined} />)}
</div>
