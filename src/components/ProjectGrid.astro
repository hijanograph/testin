---
import ProjectCard from './ProjectCard.astro';
import { getAllAreas } from '../data/projects';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'portfolio'>[];
  mode?: 'dim' | 'hide';
  numbered?: boolean;
}

const { projects, mode = 'hide', numbered = false } = Astro.props;
const areas = getAllAreas(projects);
---

<div class="projects-view" data-mode={mode}>
  <div class="filter" role="group" aria-label="Filtrar proyectos por área" hidden>
    <button type="button" class="filter__btn t-label" data-area="all" aria-pressed="true">Todos</button>
    {areas.map((area) => (
      <button type="button" class="filter__btn t-label" data-area={area.slug} aria-pressed="false">
        {area.label}
      </button>
    ))}
    {numbered && (
      <div class="filter__field">
        <label class="filter__number t-label">
          <input
            class="filter__input"
            type="number"
            min="1"
            max={projects.length}
            inputmode="numeric"
            placeholder="Nº"
            aria-label="Filtrar por número de proyecto"
          />
        </label>
        <p class="t-body t-muted projects-view__empty" role="status" hidden>Ningún proyecto con ese número.</p>
      </div>
    )}
  </div>

  <div class="projects__grid">
    {projects.map((project, i) => <ProjectCard project={project} index={numbered ? i : undefined} />)}
  </div>
</div>

<script>
  const init = () => {
    const view = document.querySelector<HTMLElement>('.projects-view');
    if (!view) return;

    const filter = view.querySelector<HTMLElement>('.filter')!;
    const number = view.querySelector<HTMLInputElement>('.filter__input');
    const empty = view.querySelector<HTMLElement>('.projects-view__empty');
    const cards = [...view.querySelectorAll<HTMLElement>('.project-card')];
    const buttons = [...filter.querySelectorAll<HTMLButtonElement>('.filter__btn')];
    const hideExcluded = view.dataset.mode === 'hide';
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const easing = 'cubic-bezier(0.2, 0.7, 0.2, 1)';
    let run = 0;
    filter.hidden = false;

    const press = (area: string) =>
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.area === area)));

    const leave = (card: HTMLElement) =>
      card.animate(
        calm
          ? [{ opacity: 1 }, { opacity: 0 }]
          : [
              { opacity: 1, transform: 'scale(1)', filter: 'blur(0)' },
              { opacity: 0, transform: 'scale(0.94)', filter: 'blur(6px)' },
            ],
        { duration: 260, easing: 'ease-out', fill: 'forwards' },
      ).finished;

    const enter = (card: HTMLElement, position: number) =>
      card.animate(
        calm
          ? [{ opacity: 0 }, { opacity: 1 }]
          : [
              { opacity: 0, transform: 'translateY(24px) scale(0.96)' },
              { opacity: 1, transform: 'none' },
            ],
        { duration: 500, delay: position * 60, easing, fill: 'backwards' },
      );

    const glide = (card: HTMLElement, from: DOMRect) => {
      const to = card.getBoundingClientRect();
      const dx = from.left - to.left;
      const dy = from.top - to.top;
      if (dx || dy) {
        card.animate(
          [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }],
          { duration: 650, easing },
        );
      }
    };

    const show = async (matches: (card: HTMLElement) => boolean, animate = true) => {
      const id = ++run;
      const visibleBefore = cards.filter((card) => !card.hidden);

      if (animate && hideExcluded) {
        const leaving = visibleBefore.filter((card) => !matches(card));
        await Promise.allSettled(leaving.map(leave));
        if (id !== run) return;
      }

      const first = new Map(visibleBefore.map((card) => [card, card.getBoundingClientRect()]));
      const filtering = cards.some((card) => !matches(card));
      let visible = 0;

      cards.forEach((card, i) => {
        card.getAnimations().forEach((animation) => animation.cancel());
        const ok = matches(card);
        if (ok) visible++;
        card.hidden = hideExcluded && !ok;
        card.classList.toggle('is-dimmed', !hideExcluded && !ok);
        card.style.order = hideExcluded || !filtering ? '' : String(ok ? i : cards.length + i);
      });

      if (empty) empty.hidden = visible > 0;
      if (!animate) return;

      let entering = 0;
      cards.forEach((card) => {
        if (card.hidden) return;
        const before = first.get(card);
        if (!before) enter(card, entering++);
        else if (!calm) glide(card, before);
      });
    };

    const selectArea = (area: string, animate = true) => {
      press(area);
      if (number) number.value = '';
      show((card) => area === 'all' || !!card.dataset.areas?.split(' ').includes(area), animate);
    };

    filter.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter__btn');
      if (!button) return;
      const area = button.dataset.area!;
      selectArea(area);
      history.replaceState(history.state, '', area === 'all' ? location.pathname + location.search : `#${area}`);
    });

    number?.addEventListener('input', () => {
      const value = number.value.trim();
      press('all');
      show((card) => !value || card.dataset.number === String(Number(value)));
    });

    const applyHash = (animate = true) => {
      const area = location.hash.slice(1);
      if (!buttons.some((b) => b.dataset.area === area)) return false;
      selectArea(area, animate);
      return true;
    };

    if (applyHash(false)) view.closest('section')?.scrollIntoView();
    const onHashChange = () => applyHash();
    window.addEventListener('hashchange', onHashChange);
    document.addEventListener('astro:before-swap', () => window.removeEventListener('hashchange', onHashChange), { once: true });
  };

  document.addEventListener('astro:page-load', init);
</script>
