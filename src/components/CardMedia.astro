---
import { withBase } from '../utils/base';

interface Props {
  src: string;
  alt: string;
  video?: string;
}

const { src, alt, video } = Astro.props;
---

{video ? (
  <video
    class="project-card__img"
    poster={src}
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    aria-label={alt}
  >
    <source src={withBase(`${video}.webm`)} type="video/webm" />
    <source src={withBase(`${video}.mp4`)} type="video/mp4" />
  </video>
) : (
  <img src={src} alt={alt} class="project-card__img" />
)}
