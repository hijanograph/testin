---
import { email, pages, pickSocials, externalLinkProps } from '../site';

const socialLinks = pickSocials('Behance', 'LinkedIn', 'Instagram');
const [user, domain] = email.split('@');
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__col">
        <p class="t-label footer__copy">
          ® {new Date().getFullYear()}<br />
          Todos los derechos reservados.
        </p>
      </div>

      <div class="footer__col footer__col--email">
        <a href={`mailto:${email}`} class="footer__email">
          {user}@<br />
          {domain}
        </a>
      </div>

      <div class="footer__col footer__col--links">
        <nav class="footer__nav" aria-label="Enlaces del pie">
          <div class="footer__nav-col footer__nav-col--social">
            {socialLinks.map(({ label, href }) => (
              <a href={href} class="footer__nav-link" {...externalLinkProps}>{label}</a>
            ))}
          </div>
          <div class="footer__nav-col">
            {pages.map(({ label, href }) => <a href={href} class="footer__nav-link">{label}</a>)}
          </div>
        </nav>
      </div>
    </div>
  </div>
</footer>
