---
import { email, social, pages } from '../site';

// Se lee en dos columnas: impares a la izquierda, pares a la derecha.
const [inicio, proyectos, sobreMi, contacto] = pages;
const links = [
  inicio, { label: 'Behance', href: social.behance, external: true },
  proyectos, { label: 'LinkedIn', href: social.linkedin, external: true },
  sobreMi, { label: 'Instagram', href: social.instagram, external: true },
  contacto,
];

const [user, domain] = email.split('@');
---

<footer class="footer">
  <div class="container">
    <hr class="footer__hr" />

    <div class="footer__grid">

      <div class="footer__col">
        <p class="t-label footer__copy">
          ® 2026<br />
          Todos los derechos reservados.
        </p>
      </div>

      <div class="footer__col footer__col--email">
        <a href={`mailto:${email}`} class="footer__email">
          {user}@<br />
          {domain}
        </a>
      </div>

      <div class="footer__col footer__col--links">
        <nav class="footer__nav" aria-label="Enlaces del pie">
          {links.map(({ label, href, external }) => (
            <a
              href={href}
              class="footer__nav-link arrow-link"
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
            >
              {label}
            </a>
          ))}
        </nav>
      </div>

    </div>
  </div>
</footer>
