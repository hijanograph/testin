---
const links = [
  { label: 'Behance', href: 'https://behance.net/rafaelhijano', external: true },
  { label: 'Inicio', href: '/' },
  { label: 'Sobre mí', href: '/sobre-mi' },
  { label: 'Currículum', href: '/curriculum' },
  { label: 'Portfolio', href: '/portfolio' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/rafaelhijano', external: true },
];
---

<footer class="footer">
  <div class="container">
    <hr class="footer__hr" />

    <div class="footer__grid">

      <div class="footer__col">
        <p class="t-label footer__copy">
          TODOS LOS DERECHOS RESERVADOS<br />
          2026 ®
        </p>
      </div>

      <div class="footer__col footer__col--email">
        <p class="t-label">Puedes tutearme en</p>

        <a href="mailto:hey@rafaelhijano.work" class="footer__email">
          hey@<br />
          rafaelhijano.work
        </a>
      </div>

      <div class="footer__col footer__col--links">
        <nav class="footer__nav">
          {links.map(({ label, href, external }) => (
            <a
              href={href}
              class="footer__nav-link arrow-link"
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
            >
              {label}
            </a>
          ))}
        </nav>
      </div>

    </div>
  </div>
</footer>