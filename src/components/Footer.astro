---
---
<footer class="footer">
  <div class="container">
    <hr class="footer__hr" />
    <div class="footer__grid">

      <!-- Col 1: copyright -->
      <div class="footer__col footer__col--copy">
        <p class="t-label footer__copy">TODOS LOS DERECHOS RESERVADOS<br />2025 ®</p>
      </div>

      <!-- Col 2: email (centro) -->
      <div class="footer__col footer__col--email">
        <p class="t-label footer__contact-label">Puedes tutearme en</p>
        <a href="mailto:hey@rafaelhijano.work" class="footer__email">
          HEY@<br />RAFAELHIJANO.WORK
        </a>
      </div>

      <!-- Col 3: links -->
      <div class="footer__col footer__col--links">
        <nav class="footer__nav">
          <a href="https://behance.net/rafaelhijano" target="_blank" rel="noopener" class="footer__nav-link arrow-link">Behance</a>
          <a href="/" class="footer__nav-link arrow-link">Inicio</a>
          <a href="/sobre-mi" class="footer__nav-link arrow-link">Sobre mí</a>
          <a href="/curriculum" class="footer__nav-link arrow-link">Currículum</a>
          <a href="/portfolio" class="footer__nav-link arrow-link">Portfolio</a>
          <a href="https://linkedin.com/in/rafaelhijano" target="_blank" rel="noopener" class="footer__nav-link arrow-link">LinkedIn</a>
        </nav>
      </div>

    </div>
  </div>
</footer>

<style>
.footer {
  padding: 0 0 2.5rem;
  margin-top: 6rem;
}

.footer__hr {
  margin-bottom: 2rem;
}

.footer__grid {
  display: grid;
  gap: 2.5rem;
  grid-template-columns: 1fr;
}

@media (min-width: 860px) {
  .footer__grid {
    grid-template-columns: 1fr 1.4fr 1fr;
    align-items: start;
    gap: 0;
  }
}

/* Col email: centro desktop */
.footer__col--email {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
@media (min-width: 860px) {
  .footer__col--email { text-align: center; align-items: center; }
}

.footer__contact-label {
  margin-bottom: 0.25rem;
}

.footer__email {
  font-size: clamp(1.4rem, 3.5vw, 2.2rem);
  font-weight: 700;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  line-height: 1.05;
  transition: opacity 0.2s;
}
.footer__email:hover { opacity: 0.55; }

/* Col copyright */
.footer__col--copy {
  display: flex;
  align-items: flex-start;
}
@media (min-width: 860px) {
  .footer__col--copy { align-items: flex-end; }
}

.footer__copy {
  line-height: 1.6;
}

/* Col links */
.footer__col--links {
  display: flex;
  justify-content: flex-start;
}
@media (min-width: 860px) {
  .footer__col--links { justify-content: flex-end; }
}

.footer__nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.6rem 2rem;
}

.footer__nav-link {
  white-space: nowrap;
}
</style>
