---
import { withBase } from '../../site';
import type { GalleryImage } from '../../data/gallery';

interface Props {
  title: string;
  // solo las fotos que van en el grid; `index` es su posición en el visor, que cuenta todas las fotos de la página
  images: (GalleryImage & { index: number })[];
  total: number;
  // proporción común de todas las casillas, para que las filas midan lo mismo
  ratio: string;
}

const { title, images, total, ratio } = Astro.props;
---

<section class="project-gallery" aria-label={`Galería de ${title}`}>
  <div class="project-gallery__grid" style={`--ratio: ${ratio}`}>
    {images.map(({ src, alt, index }, i) => (
      <button
        type="button"
        class="project-gallery__item"
        data-lightbox-index={index}
        aria-label={`Ampliar imagen ${index + 1} de ${total}`}
      >
        <img
          class="project-gallery__img"
          src={withBase(src)}
          alt={alt || `${title} - imagen ${i + 1}`}
          loading="lazy"
          decoding="async"
        />
      </button>
    ))}
  </div>
</section>
