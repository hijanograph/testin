---
import Media from '../Media.astro';

interface Props {
  title: string;
  image?: string;
}

const { title, image } = Astro.props;
---

<div class="project-wip">
  {image && <Media src={image} alt={`${title} - en proceso`} class="project-wip__img" loading="lazy" />}
  <p class="project-wip__text t-label t-muted">Proyecto bajo construcción</p>
</div>