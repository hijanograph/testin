---
import Media from './Media.astro';

interface Props {
  src?: string;
  alt?: string;
  width?: number;
  height?: number;
  belowTitle?: boolean;
}

const { src, alt = '', width, height, belowTitle = false } = Astro.props;
---

<div class:list={['hero-frame', { 'hero-frame--below-title': belowTitle }]}>
  {src ? (
    <Media src={src} alt={alt} width={width} height={height} fetchpriority="high" class="hero-frame__img" />
  ) : (
    <div class="img-placeholder img-placeholder--wide hero-frame__img"></div>
  )}
</div>
