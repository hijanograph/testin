---
import { withBase } from '../utils/base';
import { imageSize } from '../utils/image-size';

interface Section {
  title?: string;
  paragraphs: string[];
}

interface Block {
  image: string;
  alt: string;
  side?: 'left' | 'right';
  sections: Section[];
}

interface Props {
  blocks: Block[];
}

const { blocks } = Astro.props;
const sizes = await Promise.all(blocks.map((block) => imageSize(block.image)));
---

<div class="project-blocks">
  {blocks.map((block, i) => (
    <section class="project-block" data-side={block.side ?? (i % 2 === 0 ? 'left' : 'right')}>
      <img
        class="project-block__img"
        src={withBase(block.image)}
        alt={block.alt}
        width={sizes[i]?.width}
        height={sizes[i]?.height}
        loading="lazy"
        decoding="async"
      />

      <div class="project-block__text">
        {block.sections.map((section) => (
          <div class="project-block__section">
            {section.title && <h2 class="t-project-title">{section.title}</h2>}
            {section.paragraphs.map((paragraph) => (
              <p class="t-body">{paragraph}</p>
            ))}
          </div>
        ))}
      </div>
    </section>
  ))}
</div>
