---
interface Props {
  title: string;
  subtitle?: string;
  area: string;
  rol: string;
  software: string;
  heroImg?: string;
  heroAlt?: string;
  prevHref?: string;
  prevLabel?: string;
  nextHref?: string;
  nextLabel?: string;
  wip?: boolean;
}

const {
  title, subtitle, area, rol, software,
  heroImg, heroAlt,
  prevHref, prevLabel,
  nextHref, nextLabel,
  wip = false,
} = Astro.props;
---

<div class="project-page">
  <div class="container">

    <!-- Hero -->
    <section class="project-hero">
      <div class="project-hero__img-wrap">
        {heroImg
          ? <img src={heroImg} alt={heroAlt || title} class="project-hero__img" />
          : <div class="img-ph img-ph--wide project-hero__img"></div>
        }
        {wip && <span class="wip-badge t-label">Proyecto en proceso</span>}
      </div>

      <div class="project-hero__info">
        <div class="project-hero__title-block">
          <h1 class="t-hero project-hero__title">{title}</h1>
          {subtitle && <p class="project-hero__subtitle t-body">{subtitle}</p>}
        </div>

        <div class="project-meta">
          <div class="project-meta__item">
            <p class="t-label">Área</p>
            <p class="t-body">{area}</p>
          </div>
          <div class="project-meta__item">
            <p class="t-label">Rol</p>
            <p class="t-body">{rol}</p>
          </div>
          <div class="project-meta__item">
            <p class="t-label">Software</p>
            <p class="t-body">{software}</p>
          </div>
        </div>
      </div>
    </section>

    <hr />

    <!-- Content slot -->
    <div class="project-content">
      <slot />
    </div>

    <!-- Nav between projects -->
    <nav class="project-nav">
      {prevHref
        ? <a href={prevHref} class="project-nav__link arrow-link project-nav__link--prev">
            ← {prevLabel ?? 'Anterior'}
          </a>
        : <span></span>
      }
      <a href="/portfolio" class="project-nav__back t-label">↩ Portfolio</a>
      {nextHref
        ? <a href={nextHref} class="project-nav__link arrow-link">
            {nextLabel ?? 'Siguiente'} →
          </a>
        : <span></span>
      }
    </nav>

  </div>
</div>

<style>
.project-page {
  padding-top: calc(var(--nav-h) + 2.5rem);
  padding-bottom: 2rem;
}

/* ── Hero ── */
.project-hero {
  display: grid;
  gap: 2.5rem;
  margin-bottom: 3rem;
}

@media (min-width: 860px) {
  .project-hero {
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 3.5rem;
  }
}

.project-hero__img-wrap {
  position: relative;
  overflow: hidden;
}

.project-hero__img {
  width: 100%;
  display: block;
}

.wip-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  background: var(--ink);
  color: var(--cream);
  padding: 0.3em 0.8em;
  font-size: 0.62rem;
}

.project-hero__info {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
}

.project-hero__title {
  margin-bottom: 0.6rem;
}

.project-hero__subtitle {
  max-width: 44ch;
}

/* Meta */
.project-meta {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.project-meta__item { display: flex; flex-direction: column; gap: 0.25rem; }
.project-meta__item .t-label { margin-bottom: 0; }
.project-meta__item .t-body  { color: var(--ink-60); max-width: none; }

/* ── Content ── */
.project-content {
  padding: 3rem 0;
  display: flex;
  flex-direction: column;
  gap: 4rem;
}

/* ── Nav ── */
.project-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 3rem;
  border-top: 1px solid var(--ink-10);
  flex-wrap: wrap;
  gap: 1rem;
}

.project-nav__back {
  color: var(--ink-60);
  transition: color 0.15s;
}
.project-nav__back:hover { color: var(--ink); }
</style>
