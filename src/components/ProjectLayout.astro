---
interface Props {
  title: string;
  subtitle?: string;
  area: string;
  rol: string;
  software: string;
  heroImg?: string;
  heroAlt?: string;
  prevHref?: string;
  prevLabel?: string;
  nextHref?: string;
  nextLabel?: string;
}

const {
  title, subtitle, area, rol, software,
  heroImg, heroAlt,
  prevHref, prevLabel,
  nextHref, nextLabel,
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const meta = [
  { label: 'Área', value: area },
  { label: 'Rol', value: rol },
  { label: 'Software', value: software },
];
---

<div class="page">
  <div class="container">

    <section class="project-hero">
      <div class="project-hero__img-wrap">
        {heroImg
          ? <img src={heroImg} alt={heroAlt || title} class="project-hero__img" />
          : <div class="img-ph img-ph--wide project-hero__img"></div>
        }
      </div>

      <div class="project-hero__info">
        <div>
          <h1 class="t-hero project-hero__title">{title}</h1>
          {subtitle && <p class="project-hero__subtitle t-body">{subtitle}</p>}
        </div>

        <div class="project-meta">
          {meta.map((m) => (
            <div class="project-meta__item">
              <p class="t-label">{m.label}</p>
              <p class="t-body">{m.value}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <hr />

    <div class="project-content">
      <slot />
    </div>

    <nav class="project-nav" aria-label="Navegación del proyecto">
      <a href={`${base}portfolio`} class="project-nav__back t-label">Portfolio</a>

      {(prevHref || nextHref) && (
        <div class="project-nav__links">
          {prevHref && <a href={prevHref} class="arrow-link">{prevLabel ?? 'Anterior'}</a>}
          {nextHref && <a href={nextHref} class="arrow-link">{nextLabel ?? 'Siguiente'}</a>}
        </div>
      )}
    </nav>

  </div>
</div>