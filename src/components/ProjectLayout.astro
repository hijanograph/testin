---
interface Props {
  title: string;
  subtitle?: string;
  area: string;
  rol: string;
  software: string;
  heroImg?: string;
  heroAlt?: string;
  prevHref?: string;
  prevLabel?: string;
  nextHref?: string;
  nextLabel?: string;
  wip?: boolean;
}

const {
  title, subtitle, area, rol, software,
  heroImg, heroAlt,
  prevHref, prevLabel,
  nextHref, nextLabel,
  wip = false,
} = Astro.props;

const meta = [
  { label: 'Área', value: area },
  { label: 'Rol', value: rol },
  { label: 'Software', value: software },
];
---

<div class="page">
  <div class="container">

    <section class="project-hero">
      <div class="project-hero__img-wrap">
        {heroImg
          ? <img src={heroImg} alt={heroAlt || title} class="project-hero__img" />
          : <div class="img-ph img-ph--wide project-hero__img"></div>
        }
        {wip && <span class="wip-badge badge t-label">Proyecto en proceso</span>}
      </div>

      <div class="project-hero__info">
        <div>
          <h1 class="t-hero project-hero__title">{title}</h1>
          {subtitle && <p class="project-hero__subtitle t-body">{subtitle}</p>}
        </div>

        <div class="project-meta">
          {meta.map((m) => (
            <div class="project-meta__item">
              <p class="t-label">{m.label}</p>
              <p class="t-body">{m.value}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <hr />

    <div class="project-content">
      <slot />
    </div>

    <nav class="project-nav">
      {prevHref
        ? <a href={prevHref} class="arrow-link">← {prevLabel ?? 'Anterior'}</a>
        : <span></span>
      }
      <a href="/portfolio" class="project-nav__back t-label">↩ Portfolio</a>
      {nextHref
        ? <a href={nextHref} class="arrow-link">{nextLabel ?? 'Siguiente'} →</a>
        : <span></span>
      }
    </nav>

  </div>
</div>