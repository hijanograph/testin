---
import LinkList from './LinkList.astro';
import { email } from '../site';
import type { Link } from '../site';

interface Props {
  title: string;
  links: Link[];
}

const { title, links } = Astro.props;
---

<section class="section stack" id="contacto">
  <h2 class="t-label t-muted">{title}</h2>
  <a href={`mailto:${email}`} class="big-email">{email}</a>
  <LinkList links={links} />
</section>
